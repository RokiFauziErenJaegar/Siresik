      rows = [...m.values()].sort((a,b)=>a.tanggal.localeCompare(b.tanggal)).map(e=>(\{tanggal:e.tanggal, hari:hari(e.tanggal), trx:e.g.size, ped:e.ped, tot:e.tot, lunas:e.lunas, pend:e.tot-e.lunas\}));\
      cols = [\{k:'tanggal',h:'Tanggal',t:'date'\},\{k:'hari',h:'Hari',t:'text'\},\{k:'trx',h:'Transaksi',t:'int'\},\{k:'ped',h:'Pedagang harian',t:'int'\},\{k:'tot',h:'Dicatat',t:'rp'\},\{k:'lunas',h:'Masuk rekening',t:'rp'\},\{k:'pend',h:'Belum cocok',t:'rp'\}];\
      total = \{trx:sum(rows,r=>r.trx), ped:sum(rows,r=>r.ped), tot:sum(rows,r=>r.tot), lunas:sum(rows,r=>r.lunas), pend:sum(rows,r=>r.pend)\};\
      break;\
    \}\
    case 'bulanan': \{\
      for(const per of perList(MULAI, CUR))\{\
        const pels = S.pelanggan.filter(p=>p.aktif && okP(p) && (!p.sejak || p.sejak<=per));\
        const pot = sum(pels, p=>isHarian(p) ? p.tarif*hariBuka(p.wilayah, per) : (p.rinci && per<p.rinci ? p.tarif : p.tarif));\
        const bs = S.bayar.filter(b=>b.periode===per && okB(b));\
