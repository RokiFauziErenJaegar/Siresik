  \}\
  return sec('pasar', 'Bayar QRIS gabungan pedagang', '', toggle+steps+body);\
\}\
function renderGab()\{\
  const el = $('#gabList'); if(!el) return;\
  const B = UI.bayar; const q = B.gq.trim().toLowerCase();\
  const pool = gabPool();\
  const list = q ? pool.filter(p=>p.nama.toLowerCase().includes(q) || p.kode.toLowerCase().includes(q) || (p.alamat||'').toLowerCase().includes(q)) : pool;\
  const sel = new Set(B.sel);\
  const shown = list.slice(0, 400);\
  el.innerHTML = shown.map(p=>\{ const on = sel.has(p.kode); const h = isHarian(p); const n = h ? 0 : tunggakan(p,CUR,false);\
    return `<div class="item gab-item $\{on?'on':''\}"><label class="gab-lbl"><input type="checkbox" data-chg="gab" value="$\{p.kode\}" $\{on?'checked':''\} aria-label="$\{esc(p.nama)\}"><div class="item-main"><b>$\{esc(p.nama)\}</b><span>$\{p.kode\} \'b7 $\{esc((p.alamat||'').split(',')[0])\}$\{p.usaha?' \'b7 '+esc(p.usaha):''\}$\{h?'':' \'b7 bulanan'\}$\{n?' \'b7 nunggak '+n+' bln':''\}</span></div></label>\
      <div class="item-side">$\{on && h ? stepper('gab-hari', gabHari(p), 'hr', p.kode) : ''\}<b>$\{rp(on?gabAmt(p):(h?p.tarif:gabAmt(p)))\}</b></div></div>`; \}).join('')\
    + (list.length>shown.length ? `<p class="muted small">$\{list.length-shown.length\} pedagang lain \'97 ketik nama untuk mencari.</p>` : '')\
    || `<div class="empty">$\{q?'Pedagang tidak ditemukan.':'Semua pedagang sudah bayar hari ini.'\}</div>`;\
  renderGabBar();\
\}\
function renderGabBar()\{\
