\}\
*\{box-sizing:border-box\}\
html,body\{background:var(--bg)\}\
body\{font-family:var(--font);color:var(--fg);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent\}\
