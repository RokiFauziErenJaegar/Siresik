/* ---------- MUTASI QRIS ---------- */\
function parseMutasi(aoa)\{\
  const reRef = /ref|rrn|referensi|no\\.?\\s*trans|id\\s*trans|trx/i, reNom = /nominal|jumlah|amount|kredit|nilai/i, reTgl = /tanggal|tgl|date|waktu/i;\
  let h = -1, ri = -1, ni = -1, di = -1;\
  for(let i=0;i<Math.min(aoa.length,20);i++)\{\
    const row = aoa[i].map(c=>String(c));\
    const a = row.findIndex(c=>reRef.test(c)), b = row.findIndex(c=>reNom.test(c));\
    if(a>=0 && b>=0)\{ h=i; ri=a; ni=b; di=row.findIndex(c=>reTgl.test(c)); break; \}\
  \}\
  if(h<0) return [];\
  const out = [];\
  for(let i=h+1;i<aoa.length;i++)\{\
    const row = aoa[i];\
    const ref = String(row[ri]??'').trim().toUpperCase();\
    const nominal = parseNominal(row[ni]);\
    if(!ref || !nominal) continue;\
    out.push(\{ref, nominal, tanggal: (di>=0 && parseTanggal(row[di])) || TODAY\});\
  \}\
  return out;\
\}\
function parseNominal(v)\{\
  let s = String(v??'').trim(); if(!s) return 0;\
  if(/[.,]\\d\{2\}$/.test(s) && ((s.match(/[.,]/g)||[]).length>1 || /\\.\\d\{2\}$/.test(s))) s = s.slice(0,-3);\
  return parseNum(s);\
\}\
function parseTanggal(v)\{\
  const s = String(v??'').trim(); let m;\
  if((m = s.match(/^(\\d\{4\})-(\\d\{1,2\})-(\\d\{1,2\})/))) return m[1]+'-'+pad(m[2])+'-'+pad(m[3]);\
  if((m = s.match(/^(\\d\{1,2\})[\\/\\-.](\\d\{1,2\})[\\/\\-.](\\d\{2,4\})/)))\{ const y = m[3].length===2 ? '20'+m[3] : m[3]; return y+'-'+pad(m[2])+'-'+pad(m[1]); \}\
  return '';\
\}\
function linkMutasi(m, grups)\{\
  const ops = [];\
  grups.forEach(g=>verifyGrup(g, m.ref).forEach(b=>ops.push(opB(b))));\
  m.grups = grups.slice();\
  ops.push(\{t:'mutasi', row:m\});\
  return ops;\
\}\
function matchMutasi(rows, src)\{\
  const known = new Set(S.mutasi.map(m=>m.ref));\
  const ids = [], dobel = [], ops = []; let auto = 0, autoPel = 0;\
  for(const row of rows)\{\
    if(known.has(row.ref))\{ dobel.push(row); continue; \}\
    known.add(row.ref);\
    const m = \{id:uid('M'), bank:'Bank Lampung', tanggal:row.tanggal, ref:row.ref, nominal:row.nominal, grups:null, file:src, oleh:userLabel(), pada:nowStamp()\};\
    const recs = refRecs(m.ref);\
    if(recs.length && recs.every(x=>x.status==='LUNAS'))\{ m.grups = refGrups(m.ref); recs.forEach(x=>\{ if(!x.mutasiRef)\{ x.mutasiRef = m.ref; ops.push(opB(x)); \} \}); \}\
    else if(recs.length && sum(recs,x=>x.nominal)===m.nominal)\{ const gs = refGrups(m.ref); gs.forEach(g=>verifyGrup(g, m.ref).forEach(b=>ops.push(opB(b)))); m.grups = gs; auto++; autoPel += sum(recs, x=>x.harian?nPedagang(x):1); \}\
    S.mutasi.push(m); ids.push(m.id); ops.push(\{t:'mutasi', row:m\});\
  \}\
  const ds = rows.map(r=>r.tanggal).sort();\
  if(ids.length)\{\
    const c = \{id:uid('C'), dari:ds[0], sampai:ds[ds.length-1], sumber:src, oleh:userLabel(), pada:nowStamp()\};\
    S.cover.push(c); ops.push(\{t:'cover', row:c\});\
    ops.push(audit('Unggah & cocokkan mutasi QRIS', 'mutasi', src+' \'b7 '+rangeLabel(ds[0], ds[ds.length-1]), null, \{transaksi:ids.length, cocok_otomatis:auto+' transaksi ('+autoPel+' pelanggan)'\}, ''));\
  \}\
  commit(ops, 'Unggah mutasi');\
  UI.mut = \{src, ids, dobel, auto\};\
  render();\
  toast(ids.length ? auto+' transaksi QRIS cocok, '+autoPel+' pelanggan langsung lunas.' : 'Semua baris di file ini sudah pernah diunggah.', 'okk');\
\}\
function mutState(m)\{\
  if(isPaired(m)) return \{state:'selesai', grups:m.grups\};\
  const recs = refRecs(m.ref);\
  if(recs.length)\{\
    const gs = refGrups(m.ref);\
    if(recs.every(x=>x.status==='LUNAS')) return \{state:'sudah', grups:gs\};\
    const tot = sum(recs,x=>x.nominal);\
    return tot===m.nominal ? \{state:'cocok', grups:gs\} : \{state:'beda', grups:gs, pid:recs[0].id, catat:tot\};\
  \}\
  const mRefs = new Set(S.mutasi.map(x=>x.ref));\
  const byRef = new Map();\
  S.bayar.forEach(x=>\{ if(x.status==='MENUNGGU' && Math.abs((new Date(x.tanggal)-new Date(m.tanggal))/864e5)<=1)\{ const r = normRef(x.nomor); byRef.set(r, (byRef.get(r)||0) + x.nominal); \} \});\
  const cands = [...byRef.entries()].filter(([r,t])=>t===m.nominal && !mRefs.has(r)).map(([r])=>r).slice(0,3);\
  return cands.length ? \{state:'mungkin', cands\} : \{state:'baru'\};\
\}\
function mutRow(m, s)\{\
  const head = `<span class="mono">$\{esc(m.ref)\}</span> \'b7 $\{tglS(m.tanggal)\} \'b7 <b>$\{rp(m.nominal)\}</b>`;\
  if(s.state==='selesai' || s.state==='sudah') return `<div class="alert a-ok"><i class="dot ok"></i><span>$\{head\}<br><b>Sudah dicocokkan:</b> $\{esc(ketGrups(s.grups))\}</span></div>`;\
  if(s.state==='cocok') return `<div class="alert a-ok"><i class="dot ok"></i><span>$\{head\}<br>Cocok: $\{esc(ketGrups(s.grups))\}<br><button class="btn btn-sm" style="margin-top:6px" data-act="mut-one" data-mid="$\{m.id\}">$\{ICON.check\}Verifikasi</button></span></div>`;\
  if(s.state==='beda') return `<div class="alert a-warn"><i class="dot warn"></i><span>$\{head\}<br>Nomor referensi cocok ($\{esc(ketGrups(s.grups))\}), tetapi total yang dicatat petugas $\{rp(s.catat)\}. Periksa daftar pembayarannya, lalu koreksi bila perlu.<br><button class="linkbtn" data-act="pay" data-id="$\{s.pid\}">Buka catatan pembayaran</button></span></div>`;\
  if(s.state==='mungkin') return `<div class="alert a-wait"><i class="dot wait"></i><span>$\{head\}<br>Nomor referensi tidak ditemukan. Mungkin milik:<br>$\{s.cands.map(r=>`<button class="btn btn2 btn-sm" style="margin:6px 6px 0 0" data-act="mut-pick" data-mid="$\{m.id\}" data-ref="$\{esc(r)\}">$\{esc(ketGrups(refGrups(r)))\}</button>`).join('')\}</span></div>`;\
  return `<div class="alert a-wait"><i class="dot wait"></i><span>$\{head\}<br>Belum ada catatan petugas untuk transaksi ini (pelanggan mungkin bayar langsung).<br><button class="btn btn2 btn-sm" style="margin-top:6px" data-act="mut-assign" data-mid="$\{m.id\}">Pilih pelanggan</button></span></div>`;\
\}\
function mutResult()\{\
  const ms = UI.mut.ids.map(id=>S.mutasi.find(m=>m.id===id)).filter(Boolean);\
  const st = ms.map(m=>(\{m, s:mutState(m)\}));\
  const n = k => st.filter(x=>x.s.state===k).length;\
  const dob = UI.mut.dobel.map(r=>`<div class="alert a-plain"><i class="dot wait"></i><span><span class="mono">$\{esc(r.ref)\}</span> \'b7 $\{tglS(r.tanggal)\} \'b7 <b>$\{rp(r.nominal)\}</b><br>Sudah pernah diunggah, dilewati.</span></div>`).join('');\
  const perlu = st.filter(x=>['beda','mungkin','baru'].includes(x.s.state));\
  const beres = st.filter(x=>!['beda','mungkin','baru'].includes(x.s.state));\
  return `<div class="stack-col" style="margin-top:4px">\
    <div class="note note-plain"><b>$\{esc(UI.mut.src)\}</b> \'b7 $\{ms.length\} transaksi baru$\{UI.mut.dobel.length?' \'b7 '+UI.mut.dobel.length+' sudah pernah diunggah':''\}</div>\
    <div class="mut-sum">$\{n('selesai')+n('sudah')?chip('LUNAS', (n('selesai')+n('sudah'))+' cocok & lunas'):''\}$\{n('cocok')?chip('LUNAS', n('cocok')+' siap diverifikasi'):''\}$\{n('mungkin')+n('baru')?chip('MENUNGGU', (n('mungkin')+n('baru'))+' perlu dipilih'):''\}$\{n('beda')?chip('PERIKSA', n('beda')+' nominal beda'):''\}</div>\
    <p class="muted small">Nomor referensi dan nominal yang sama persis langsung dicocokkan dan menjadi lunas. Sisanya perlu dipilih atau diperiksa bendahara.</p>\
    $\{n('cocok') ? `<button class="btn btn-block" data-act="mut-apply">$\{ICON.checks\}Verifikasi $\{n('cocok')\} pembayaran yang cocok</button>` : ''\}\
    $\{perlu.length ? `<p class="flabel">Perlu tindakan ($\{perlu.length\})</p><div class="alerts">$\{perlu.map(x=>mutRow(x.m, x.s)).join('')\}</div>` : ''\}\
    $\{beres.length || dob ? `<details class="fold"><summary>Lihat $\{beres.length\} transaksi yang cocok$\{UI.mut.dobel.length?' dan '+UI.mut.dobel.length+' yang dilewati':''\}</summary><div class="alerts">$\{beres.map(x=>mutRow(x.m, x.s)).join('')\}$\{dob\}</div></details>` : ''\}\
    <button class="linkbtn" data-act="mut-close">Tutup hasil pencocokan</button>\
  </div>`;\
\}\
