function targetCard()\{\
  const tgt = (S.settings.target||\{\})[YEAR] || 0;\
  const ini = terimaPerBulan(YEAR);\
  const laluSet = (S.settings.lalu||\{\})[YEAR-1];\
  const lalu = laluSet || (S.bayar.some(b=>+b.tanggal.slice(0,4)===YEAR-1) ? terimaPerBulan(YEAR-1) : null);\
  const m = CUR_M();\
  const ytd = sum(ini.slice(0, m));\
  const mb = Math.max(1, m-1);                       // bandingkan bulan yang sudah selesai\
  const iniB = sum(ini.slice(0, mb)), lytd = lalu ? sum(lalu.slice(0, mb)) : null;\
  const pct = pctOf(ytd, tgt);\
  const naik = lytd ? Math.round((iniB-lytd)/lytd*100) : null;\
  const rentang = mb===1 ? BLN[0] : BLN[0]+'\'96'+BLN[mb-1];\
  return `<section class="card">\
    <div class="real-head"><span class="lbl">Penerimaan $\{YEAR\} s.d. $\{esc(tglS(TODAY))\}</span><span class="real-pct">$\{rp(ytd)\}<small>$\{tgt?pct+'% dari target '+rp(tgt):'Target tahunan belum diisi'\}</small></span></div>\
    $\{tgt?`<div class="pbar" role="img" aria-label="$\{pct\}% dari target"><i class="b-ok" style="width:$\{Math.min(100,pct)\}%"></i></div>`:''\}\
    <div class="plegend two">\
      <span><i class="sdot b-ok"></i><span>Sisa menuju target<b>$\{tgt?rp(Math.max(0,tgt-ytd)):'\'97'\}</b></span></span>\
      <span><i class="sdot" style="background:var(--slate-700)"></i><span>$\{rentang\} $\{YEAR\} dibanding $\{YEAR-1\}<b>$\{lytd!=null?rpS(iniB)+' vs '+rpS(lytd)+(naik!=null?` <em class="$\{naik>=0?'t-em':'t-bad'\}">$\{naik>=0?'naik':'turun'\} $\{Math.abs(naik)\}%</em>`:''):'\'97'\}</b></span></span>\
    </div>\
  </section>`;\
\}\
function harianStat(M, wilNama)\{\
  const ped = S.pelanggan.filter(p=>p.aktif && isHarian(p) && p.wilayah===wilNama);\
  const pos = posOf(wilNama);\
  let bayarHI = 0, tunggu = 0, hariM = 0;\
  for(const p of ped)\{ const e = IX.hIdx.get(p.kode); if(!e) continue; hariM += e.per[M]||0; const s = e.tgl.get(TODAY); if(s)\{ bayarHI++; if(s!=='LUNAS') tunggu++; \} \}\
  const rpM = pos ? sum(S.bayar.filter(b=>b.pel===pos.kode && b.status!=='BATAL' && b.periode===M), b=>b.nominal) : 0;\
  const hb = hariBuka(wilNama, M);\
  return \{n:ped.length, bayarHI, tunggu, hariM, rpM, pot: sum(ped,p=>p.tarif)*hb, hb\};\
\}\
function harianCard(M)\{\
  const kini = M===CUR;\
  const ws = S.wilayah.filter(w=>w.jenis==='pasar' && w.aktif!==false).map(w=>(\{w, s:harianStat(M, w.nama)\})).filter(x=>x.s.n || x.s.rpM);\
  if(!ws.length) return '';\
  const tot = \{n:sum(ws,x=>x.s.n), hi:sum(ws,x=>x.s.bayarHI), hari:sum(ws,x=>x.s.hariM), rp:sum(ws,x=>x.s.rpM)\};\
  const rows = ws.map((\{w,s\})=>\{\
    const pct = s.n ? pctOf(s.bayarHI, s.n) : 0;\
    return `<div class="hrow">\
      <div class="hrow-top"><b>$\{esc(w.nama)\}</b><span class="muted small">$\{esc(ptgNama(w.ptg))\}</span></div>\
      $\{s.n ? `<div class="pbar sm"><i class="b-ok" style="width:$\{kini?pct:pctOf(s.hariM, s.n*s.hb)\}%"></i></div>` : ''\}\
      <div class="kol-meta">$\{s.n ? `<span>$\{kini?'Bayar hari ini':'Hari dibayar'\}: <b>$\{kini?ribu(s.bayarHI)+' / '+ribu(s.n):ribu(s.hariM)\}</b></span>` : '<span>Daftar pedagang belum ada</span>'\}<span>$\{esc(blnS(M))\}: <b>$\{rp(s.rpM)\}</b></span>$\{s.tunggu&&kini?`<span class="t-wait">$\{s.tunggu\} menunggu verifikasi</span>`:''\}</div>\
    </div>`;\
  \}).join('');\
  return sec('pasar', 'Pedagang pasar \'b7 Rp2.000 per hari', kini ? `$\{ribu(tot.hi)\} dari $\{ribu(tot.n)\} bayar hari ini` : esc(blnLabel(M)), `\
    <div class="hsum"><div><span class="lbl">$\{kini?'Bayar hari ini':'Pedagang'\}</span><b>$\{kini?ribu(tot.hi):ribu(tot.n)\}</b></div><div><span class="lbl">Hari dibayar $\{esc(blnS(M))\}</span><b>$\{ribu(tot.hari)\}</b></div><div><span class="lbl">Rupiah $\{esc(blnS(M))\}</span><b>$\{rpS(tot.rp)\}</b></div></div>\
    <div class="hlist">$\{rows\}</div>`, 'p0');\
\}\
function perPtgCard(M)\{\
  const isCur = M===CUR;\
  const last = \{\}, tahun = \{\};\
  const y = +M.slice(0,4);\
  for(const b of S.bayar)\{ if(b.status==='BATAL') continue; if(!last[b.ptg] || b.tanggal>last[b.ptg]) last[b.ptg] = b.tanggal; if(b.periode<=M && +b.periode.slice(0,4)===y) tahun[b.ptg] = (tahun[b.ptg]||0) + b.nominal; \}\
  const kosong = [];\
  const row = k => \{\
    const R = ringkas(M, k.id);\
    const wil = wilPtg(k.id);\
    if(!wil && !tahun[k.id] && !R.terdaftar)\{ kosong.push(k.nama); return ''; \}\
    const pct = R.aktif ? pctOf(R.lunas+R.menunggu, R.aktif) : null;\
    const pill = R.aktif ? pct+'%' : (R.hN && isCur ? pctOf(R.hHariIni, R.hN)+'% hari ini' : (R.rekapN ? 'Rekap' : '\'97'));\
    const sebut = k.jenis==='pasar' ? 'Pelanggan bulanan' : k.jenis==='langsung' ? 'Instansi/badan' : 'Pelanggan';\
    let foot = '';\
    if(isCur)\{\
      const e = rekonRange(TODAY, TODAY, k.id)[0];\
      if(e) foot = `<div class="kol-foot"><span>Dicatat hari ini: <b class="num">$\{rp(e.dipungut)\}</b></span><span>$\{chip(e.status, e.status==='TUNGGU'?'Menunggu':null)\}</span></div>`;\
    \} else if(R.periksaN) foot = `<div class="kol-foot"><span>Selisih bulan ini: <b class="num">$\{rp(R.selisih)\}</b></span>$\{chip('PERIKSA')\}</div>`;\
    const meta = [];\
    if(R.aktif||R.rekapN) meta.push(`<span>$\{sebut\}: <b>$\{R.aktif||R.rekapN\}</b>$\{!R.aktif&&R.rekapN?' (direkap)':''\}</span>`+(R.aktif?`<span>Lunas <b class="t-em">$\{R.lunas\}</b></span><span>Menunggu <b class="t-wait">$\{R.menunggu\}</b></span><span>Belum <b class="t-bad">$\{R.belum\}</b></span>`:''));\
    if(R.hN) meta.push(`<span>Pedagang harian: <b>$\{ribu(R.hN)\}</b></span>$\{isCur?`<span>Bayar hari ini <b class="t-em">$\{ribu(R.hHariIni)\}</b></span>`:''\}<span>Hari dibayar $\{esc(blnS(M))\} <b>$\{ribu(R.hHari)\}</b></span>`);\
    meta.push(`<span>$\{esc(blnS(M))\}: <b class="t-blue">$\{rp(R.total)\}</b></span><span>s.d. $\{esc(blnS(M))\} $\{y\}: <b>$\{rp(tahun[k.id]||0)\}</b></span><span>Terakhir: <b>$\{last[k.id]?tglS(last[k.id]):'\'97'\}</b></span>`);\
    if(R.pendRp||R.rekapRp||R.nunggak3) meta.push((R.pendRp?`<span>Menunggu dicocokkan: <b class="t-wait">$\{rp(R.pendRp)\}</b></span>`:'')+(R.rekapRp?`<span>Setoran tanpa rincian: <b>$\{rp(R.rekapRp)\}</b></span>`:'')+(R.nunggak3?`<span>Menunggak \uc0\u8805 3 bln: <b class="t-bad">$\{R.nunggak3\}</b></span>`:''));\
    return `<div class="kol-row">\
      <div class="kol-top"><div class="kol-name"><b>$\{esc(k.lengkap)\}</b>$\{wil?`<span class="pill">$\{esc(wil)\}</span>`:''\}</div><span class="pct-pill">$\{pill\}</span></div>\
      $\{R.aktif ? stackBar(R,true) : ''\}\
      $\{meta.map(x=>`<div class="kol-meta">$\{x\}</div>`).join('')\}\
      $\{foot\}\
    </div>`;\
  \};\
  const grp = (js, label) => \{ const h = S.petugas.filter(k=>js.includes(k.jenis) && k.aktif!==false).map(row).join(''); return h ? `<div class="kol-grp">$\{label\}</div>$\{h\}` : ''; \};\
  const body = grp(['jalan'],'Jalan protokol') + grp(['pasar'],'Pasar') + grp(['pos','langsung'],'Pos lain & bayar langsung');\
  return sec('user', 'Kinerja per petugas monitor', esc(blnLabel(M)), `<div class="kol-list">$\{body\}</div>$\{kosong.length?`<p class="muted small" style="padding:10px 14px">Belum punya wilayah: $\{esc(kosong.join(', '))\}.</p>`:''\}`, 'p0');\
\}\
function perhatianCard(M)\{\
  const items = [];\
  rekonRange(M+'-01', monthEnd(M), '').filter(e=>e.status==='PERIKSA').slice(0,5).forEach(e=>\{\
    items.push(`<button class="alert a-warn" data-act="goto-rekon" data-d="$\{e.tanggal\}" data-k="$\{e.ptg\}"><i class="dot warn"></i><span><b>$\{esc(ptgNama(e.ptg))\} \'b7 $\{tglS(e.tanggal)\}</b> \'97 selisih $\{rp(e.selisih)\}. $\{e.note?'Keterangan: '+esc(e.note.teks):'<b>Belum ada keterangan.</b>'\}</span></button>`);\
  \});\
  const lc = lastCover();\
  const late = S.bayar.filter(b=>b.status==='MENUNGGU' && b.tanggal>lc && b.tanggal.slice(0,7)<=M);\
  if(late.length) items.push(`<button class="alert a-wait" data-act="goto-verif"><i class="dot wait"></i><span>$\{lc?`Mutasi rekening sejak <b>$\{tglS(addDays(lc,1))\}</b> belum diunggah.`:'Mutasi rekening Bank Lampung belum pernah diunggah.'\} <b>$\{new Set(late.map(b=>normRef(b.nomor))).size\} transaksi QRIS</b> ($\{rp(sum(late,b=>b.nominal))\}) menunggu dicocokkan.</span></button>`);\
  const lepas = S.mutasi.filter(m=>!isPaired(m));\
  if(lepas.length) items.push(`<button class="alert a-wait" data-act="goto-verif"><i class="dot wait"></i><span><b>$\{lepas.length\} dana QRIS</b> ($\{rp(sum(lepas,m=>m.nominal))\}) sudah masuk rekening tetapi belum dipasangkan ke pelanggan.</span></button>`);\
  const R = ringkas(M,'');\
  if(R.nunggak3) items.push(`<button class="alert a-plain" data-act="goto-pel" data-st="NUNGGAK"><i class="dot bad"></i><span><b>$\{R.nunggak3\} pelanggan bulanan</b> menunggak 3 bulan atau lebih. Perlu didatangi atau disurati.</span></button>`);\
  const tanpa = S.wilayah.filter(w=>w.jenis==='jalan' && w.aktif!==false && !S.pelanggan.some(p=>p.wilayah===w.nama));\
  if(tanpa.length) items.push(`<div class="alert a-plain"><i class="dot wait"></i><span>Daftar pelanggan <b>$\{esc(tanpa.map(w=>w.nama).join(', '))\}</b> belum ada. $\{can.editPel()?'Impor dari Excel di menu Pelanggan.':'Admin dapat mengimpornya dari Excel.'\}</span></div>`);\
  if(!items.length) items.push(`<div class="alert a-ok"><i class="dot ok"></i><span><b>Semua sesuai.</b> Tidak ada pembayaran tertunda atau selisih bulan ini.</span></div>`);\
  return sec('alert', 'Perlu perhatian', 'Ketuk untuk rincian', `<div class="alerts">$\{items.join('')\}</div>`);\
\}\
function trendCard()\{\
  const ini = terimaPerBulan(YEAR);\
  const lalu = (S.settings.lalu||\{\})[YEAR-1] || (S.bayar.some(b=>+b.tanggal.slice(0,4)===YEAR-1) ? terimaPerBulan(YEAR-1) : null);\
  const mx = Math.max(1, ...ini, ...(lalu||[0]));\
  const m = CUR_M();\
  let cols = '';\
  for(let i=0;i<12;i++)\{\
    const a = ini[i], b = lalu ? lalu[i] : 0, fut = i+1 > m;\
    cols += `<div class="bar-col $\{i+1===m?'cur':''\}"><span class="bar-val">$\{fut?'':(a/1e6).toFixed(0)\}</span><div class="bar-track two">$\{lalu?`<i class="b-lalu" style="height:$\{(b/mx*100).toFixed(1)\}%"></i>`:''\}<i style="height:$\{fut?0:(a/mx*100).toFixed(1)\}%"></i></div><span class="bar-lbl">$\{BLN[i]\}</span></div>`;\
  \}\
  return sec('history', 'Penerimaan per bulan (juta rupiah)', lalu ? `<span class="lg"><i class="sdot b-ok"></i>$\{YEAR\}</span> <span class="lg"><i class="sdot b-lalu"></i>$\{YEAR-1\}</span>` : String(YEAR),\
    `<p class="muted small">Menurut tanggal setor, sama dengan lembar REKAP bendahara.</p><div class="bars" style="--n:12">$\{cols\}</div>`);\
\}\
function refItem(ref, list)\{\
