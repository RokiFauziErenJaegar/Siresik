      const order = S.wilayah.map(w=>w.nama).concat([...by.keys()].filter(k=>!S.wilayah.some(w=>w.nama===k)));\
      rows = order.filter(w=>by.has(w) || (wilByNama(w)||\{\}).aktif!==false).map(w=>\{ const a = by.get(w)||Array(12).fill(0); const r = \{pos:w, ptg:ptgNama((wilByNama(w)||\{\}).ptg), tot:sum(a)\}; a.forEach((v,i)=>r['m'+i]=v); return r; \});\
      cols = [\{k:'pos',h:'Pos setor',t:'text'\},\{k:'ptg',h:'Petugas',t:'text'\}].concat(BLN.map((b,i)=>(\{k:'m'+i,h:b,t:'rp'\}))).concat([\{k:'tot',h:'Jumlah',t:'rp'\}]);\
