async function tampilMasuk(msg)\{\
  if(MODE==='lokal') return;\
  closeSheetIfOpen();\
  $('#app').hidden = true;\
  const el = $('#masuk'); el.hidden = false;\
  const shell = inner => `<div class="login"><div class="login-card">\
    <div class="login-brand"><div class="logo">$\{ICON.logo\}</div><div><b>RESIK COLLECT</b><span>Monitoring Retribusi Persampahan</span><span>Dinas Lingkungan Hidup Kab. Pringsewu</span></div></div>\
    $\{inner\}</div><p class="login-foot">Pembayaran melalui QRIS Bank Lampung \'b7 Tarif sesuai Perda Kab. Pringsewu No. 1 Tahun 2024</p></div>`;\
  el.innerHTML = shell('<div class="empty">Memuat\'85</div>');\
  let list;\
  try\{ list = (await api('pengguna')).pengguna; \}\
  catch(e)\{\
    if(e.belumPasang)\{ el.innerHTML = shell(`<div class="note note-wait">Aplikasi belum dipasang di server ini.</div><a class="btn btn-block" href="install.php">Buka halaman pemasangan</a>`); return; \}\
    el.innerHTML = shell(`<div class="note note-bad">$\{esc(e.message)\}</div><button class="btn btn-block" data-act="masuk-ulang">$\{ICON.refresh\}Coba lagi</button>`); return;\
  \}\
  const last = ls.get('resik-terakhir', '');\
  const grp = [['kadis','Admin / Kadis'],['bendahara','Bendahara'],['petugas','Petugas monitor'],['monev','Monev']];\
  el.innerHTML = shell(`\
    $\{msg?`<div class="note note-wait">$\{esc(msg)\}</div>`:''\}\
    <form class="form" data-form="masuk" novalidate>\
      <div class="field"><label for="m-id">Nama pengguna</label><select id="m-id" class="inp big">$\{grp.map(([k,l])=>\{ const us = list.filter(u=>u.peran===k); return us.length?`<optgroup label="$\{l\}">$\{us.map(u=>`<option value="$\{esc(u.id)\}" $\{u.id===last?'selected':''\}>$\{esc(u.nama)\}</option>`).join('')\}</optgroup>`:''; \}).join('')\}</select></div>\
      <div class="field"><label for="m-pin">PIN (6 angka)</label><input id="m-pin" class="inp big pin" type="password" inputmode="numeric" maxlength="6" autocomplete="current-password" placeholder="\'95\'95\'95\'95\'95\'95"></div>\
      <p class="note note-bad" id="m-err" hidden></p>\
      <button class="btn btn-block btn-big" type="submit">$\{ICON.lock\}Masuk</button>\
    </form>\
    <p class="muted small" style="text-align:center">Lupa PIN? Minta Admin/Kadis membuat PIN baru.</p>`);\
  setTimeout(()=>\{ const p = $('#m-pin'); if(p) p.focus(); \}, 50);\
\}\
async function submitMasuk()\{\
  const id = $('#m-id').value, pin = $('#m-pin').value.trim();\
  const err = m => \{ const e = $('#m-err'); e.textContent = m; e.hidden = false; \};\
  if(!/^\\d\{6\}$/.test(pin)) return err('PIN harus 6 angka.');\
  const btn = $('#masuk button[type=submit]'); btn.disabled = true;\
  try\{\
    await api('masuk', \{id, pin\});\
    ls.set('resik-terakhir', id);\
    const j = await api('data');\
    stateFromServer(j); loadOutbox(); simpanCache();\
    UI.tab = 'dashboard'; UI.bayar = freshBayar(); resetTanggalUI();\
    render(); flush();\
    toast('Selamat datang, '+S.me.nama+'.', 'okk');\
  \}catch(e)\{ btn.disabled = false; err(e.message); $('#m-pin').value=''; $('#m-pin').focus(); \}\
\}\
