async function boot()\{\
  if(MODE==='lokal')\{ bootLokal(); resetTanggalUI(); render(); return; \}\
  if(location.protocol==='http:' && !/^(localhost|127\\.|192\\.168\\.|10\\.)/.test(location.hostname)) $('#httpWarn').hidden = false;\
  try\{\
    const j = await api('data');\
    stateFromServer(j); resetTanggalUI(); loadOutbox(); simpanCache(); render(); flush();\
  \}catch(e)\{\
    if(e.status===401 || e.keluar) return tampilMasuk();\
    if(e.belumPasang) return tampilMasuk();\
    const c = ls.get('resik-cache', null);\
    if(e.jaringan && c && c.me)\{\
      S = emptyState(); S.me = c.me; S.ub = c.ub||0; setToday(hariIniLokal());\
      TBL.forEach(t=>setTable(t, c.rows[t])); sortAudit(); loadOutbox();\
      SYNC.offline = true; render(); toast('Tidak ada sinyal. Menampilkan data terakhir ('+c.t+').', 'bad');\
