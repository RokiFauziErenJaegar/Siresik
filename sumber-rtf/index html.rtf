function parseImpor(aoa)\{\
  const cari = (row, re) => row.findIndex(c=>re.test(String(c||'')));\
  let h = -1, ci = \{\};\
  for(let i=0;i<Math.min(aoa.length,30);i++)\{\
    const row = aoa[i].map(c=>String(c||'').trim());\
    const n = cari(row, /^(nama( pelanggan| usaha| pemilik)?|objek retribusi)$/i);\
    if(n>=0)\{ h = i; ci = \{nama:n, alamat:cari(row,/alamat|lokasi|^ket/i), wa:cari(row,/telepon|telp|wa|hp/i), usaha:cari(row,/usaha/i), kat:cari(row,/kode tarif|jenis tarif/i), skala:cari(row,/skala/i), tarif:cari(row,/tarif/i)\};\
      if(ci.tarif===ci.kat) ci.tarif = row.findIndex((c,j)=>j!==ci.kat && /tarif/i.test(c)); break; \}\
  \}\
  if(h<0) return null;\
  const out = [];\
  for(let i=h+1;i<aoa.length;i++)\{\
    const r = aoa[i]; const g = k => ci[k]>=0 ? String(r[ci[k]]??'').trim() : '';\
    const nama = g('nama').replace(/\\s+/g,' ');\
    if(!nama || /^\\d+$/.test(nama)) continue;\
    let wa = g('wa').replace(/\\D/g,''); if(wa.startsWith('62')) wa = '0'+wa.slice(2); else if(wa.startsWith('8')) wa = '0'+wa; if(wa.length<9||wa.length>14) wa = '';\
    const us = g('usaha'); const kat = g('kat').toUpperCase(); const sk = g('skala').toUpperCase().slice(0,6);\
    out.push(\{nama, alamat:g('alamat').replace(/\\s+/g,' '), wa, usaha: us ? us[0].toUpperCase()+us.slice(1).toLowerCase() : '', kat: KATEGORI.some(k=>k.id===kat) ? kat : '', skala: (\{KECIL:'K',SEDANG:'S',BESAR:'B'\})[sk] || sk, tarif: parseNum(g('tarif'))\});\
  \}\
  return out;\
\}\
