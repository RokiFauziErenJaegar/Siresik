  \}\
  R.potensi += R.hPot;\
  const g = new Set(), gp = new Set();\
  for(const b of S.bayar)\{\
    if(b.status==='BATAL' || b.periode!==M) continue;\
    if(ptg && b.ptg!==ptg) continue;\
    R.total += b.nominal; g.add(b.grup);\
    if(b.harian) R.hRp += b.nominal;\
    if(b.rekap) R.rekapRp += b.nominal;\
    if(b.sumber==='FILE') R.fileRp += b.nominal;\
    if(b.status==='LUNAS') R.lunasRp += b.nominal; else \{ R.pendRp += b.nominal; gp.add(b.grup); \}\
  \}\
