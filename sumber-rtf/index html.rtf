.brand\{display:flex;align-items:center;gap:10px;min-width:0\}\
.logo\{width:36px;height:36px;border-radius:9px;background:var(--em-600);border:1px solid var(--em-400);display:flex;align-items:center;justify-content:center;flex:none;box-shadow:inset 0 1px 3px rgba(0,0,0,.18)\}\
