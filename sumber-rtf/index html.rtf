function renderAssign(mid, q)\{\
  const m = S.mutasi.find(x=>x.id===mid); if(!m) return;\
  q = q.trim().toLowerCase();\
  let list = S.pelanggan.filter(p=>p.aktif);\
  if(q) list = list.filter(p=>p.nama.toLowerCase().includes(q) || p.kode.toLowerCase().includes(q) || p.kode.replace('PSW-','').includes(q));\
  else list = list.filter(p=>!isHarian(p) && p.tarif===m.nominal && stBulan(p,CUR).k==='BELUM');\
  $('#asRes').innerHTML = (q?'':`<p class="muted small">Belum bayar $\{blnLabel(CUR)\} dengan tarif $\{rp(m.nominal)\}:</p>`) + (list.slice(0,15).map(p=>`<button class="item" data-act="mut-assign-pick" data-mid="$\{mid\}" data-kode="$\{p.kode\}"><div class="item-main"><b>$\{esc(p.nama)\}</b><span>$\{p.kode\} \'b7 $\{esc(p.wilayah)\} \'b7 $\{esc(ptgNama(p.ptg))\}</span></div><div class="item-side"><b>$\{tarifLabel(p)\}</b>$\{chipKini(p)\}</div></button>`).join('') || '<div class="empty">Pelanggan tidak ditemukan. Ketik nama untuk mencari.</div>');\
\}\
