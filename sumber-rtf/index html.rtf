      <div class="qi-top"><div class="item-main">$\{L.main\}<span class="mono t-blue">Ref $\{esc(L.b.nomor)\}</span></div><div class="item-side"><b class="num">$\{rp(L.tot)\}</b>$\{chipB(L.b)\}</div></div>\
      <div class="qi-btns"><button class="btn btn2 btn-sm" data-act="pay" data-id="$\{L.b.id\}">Rincian</button><button class="btn btn-sm" data-act="verif-ref" data-ref="$\{esc(x.ref)\}">$\{ICON.check\}Sudah masuk</button></div>\
    </div>`; \}).join('');\
  const shown = new Set(UI.mut ? UI.mut.ids : []);\
