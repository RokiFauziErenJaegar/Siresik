/* Tombol & isian */\
.btn\{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 18px;border-radius:12px;border:0;font-weight:700;font-size:14.5px;background:var(--em-600);color:var(--on-dark);text-decoration:none;text-align:center;box-shadow:var(--sh-sm)\}\
