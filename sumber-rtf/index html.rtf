function submitBayar()\{\
  const B = UI.bayar, p = IX.pelMap.get(B.pel);\
  const nominal = parseNum($('#f-nominal').value), tanggal = $('#f-tanggal').value, nomor = normRef(($('#f-nomor').value||'').trim());\
  const err = msg => fieldErr('f-err', msg);\
  if(!nominal) return err('Isi nominal pembayaran.');\
  if(!tanggal) return err('Isi tanggal transaksi.');\
  if(tanggal>TODAY) return err('Tanggal tidak boleh melewati hari ini.');\
  const ne = cekNomor(nomor); if(ne) return err(ne);\
  const langsung = role()==='bendahara' && $('#f-langsung') && $('#f-langsung').checked;\
  const status = langsung ? 'LUNAS' : 'MENUNGGU';\
  const ops = []; let grup;\
  if(isHarian(p))\{\
    const tot = B.hari*p.tarif;\
    if(nominal!==tot) return err('Nominal harus '+rp(tot)+' ('+B.hari+' hari \'d7 '+rp(p.tarif)+').');\
    const pos = posOf(p.wilayah); if(!pos) return err('Pos pasar '+p.wilayah+' belum ada. Hubungi Admin.');\
    const rec = createHarian(pos, \{[p.kode]:B.hari\}, \{tanggal, nomor, status\});\
    grup = rec.grup; ops.push(opB(rec));\
  \} else \{\
    const tl = tagihanList(p); const tot = sum(tl.filter(t=>B.months.includes(t.per)), t=>t.kurang);\
    if(nominal!==tot && !($('#f-ok') && $('#f-ok').checked))\{\
      B.draft = \{nominal, tanggal, nomor\};\
      B.warn = nominal<tot ? `Nominal kurang $\{rp(tot-nominal)\} dari tagihan $\{rp(tot)\}. Bulan terakhir akan tercatat belum lunas.` : `Nominal lebih $\{rp(nominal-tot)\} dari tagihan $\{rp(tot)\}.`;\
      render(); const w = $('#f-ok'); if(w) w.closest('.note').scrollIntoView(\{block:'center'\}); return;\
    \}\
    const r = createPayments(p, alokasi(p, B.months, nominal), \{tanggal, nomor, ptg: isPtg()?myPtg():p.ptg, status\});\
    grup = r.grup; r.recs.forEach(b=>ops.push(opB(b)));\
  \}\
  const mm = S.mutasi.find(m=>!isPaired(m) && m.ref===nomor && m.nominal===nominal);\
  if(mm && role()==='bendahara') ops.push(...linkMutasi(mm, [grup]));\
  reindex();\
  ops.push(audit('Catat pembayaran QRIS', grup, grupKet(grup), null, \{nominal, nomor\}, ''));\
  commit(ops, 'Catat pembayaran');\
  B.step='sukses'; B.last=\{grup, kode:p.kode\}; B.draft=null; B.warn='';\
  render(); scrollToCatat(); toast(mm && role()==='bendahara' ? 'Pembayaran tersimpan dan langsung cocok dengan mutasi rekening.' : 'Pembayaran tersimpan.', 'okk');\
\}\
function submitGabung()\{\
  const B = UI.bayar; const sel = gabSel(); const tot = sum(sel, gabAmt);\
  const nominal = parseNum($('#f-nominal').value), tanggal = $('#f-tanggal').value, nomor = normRef(($('#f-nomor').value||'').trim());\
  const err = msg => \{ B.draft = \{nominal, tanggal, nomor\}; fieldErr('f-err', msg); \};\
  if(!sel.length) return err('Belum ada pedagang yang dicentang.');\
  if(!nominal) return err('Isi nominal yang dibayar lewat QRIS.');\
  if(!tanggal) return err('Isi tanggal transaksi.');\
  if(tanggal>TODAY) return err('Tanggal tidak boleh melewati hari ini.');\
  const ne = cekNomor(nomor); if(ne) return err(ne);\
  if(nominal!==tot) return err(`Nominal QRIS $\{rp(nominal)\} tidak sama dengan jumlah pembayaran pedagang yang dicentang ($\{rp(tot)\}). Kembali ke daftar dan sesuaikan.`);\
  const langsung = role()==='bendahara' && $('#f-langsung') && $('#f-langsung').checked;\
  const status = langsung ? 'LUNAS' : 'MENUNGGU';\
  const batch = uid('B'); const ops = []; const grups = [];\
  const harian = sel.filter(isHarian), bulanan = sel.filter(p=>!isHarian(p));\
  const byWil = \{\}; harian.forEach(p=>\{ (byWil[p.wilayah] = byWil[p.wilayah] || \{\})[p.kode] = gabHari(p); \});\
  for(const [w, items] of Object.entries(byWil))\{\
    const pos = posOf(w); if(!pos) return err('Pos pasar '+w+' belum ada. Hubungi Admin.');\
    const rec = createHarian(pos, items, \{tanggal, nomor, status, batch\}); grups.push(rec.grup); ops.push(opB(rec));\
  \}\
  bulanan.forEach(p=>\{ const r = createPayments(p, [\{per:CUR, nominal:gabAmt(p)\}], \{tanggal, nomor, ptg:isPtg()?myPtg():p.ptg, status, batch\}); grups.push(r.grup); r.recs.forEach(b=>ops.push(opB(b))); \});\
  const mm = S.mutasi.find(m=>!isPaired(m) && m.ref===nomor && m.nominal===tot);\
  if(mm && role()==='bendahara') ops.push(...linkMutasi(mm, grups));\
  reindex();\
  ops.push(audit('Catat QRIS gabungan pasar', batch, (sel[0].wilayah)+' \'b7 '+sel.length+' pedagang \'b7 '+rp(tot), null, \{nomor, pedagang:sel.length, hari:sum(harian,gabHari)\}, ''));\
  commit(ops, 'QRIS gabungan');\
  B.step='sukses'; B.last=\{batch\}; B.sel=[]; B.hsel=\{\}; B.draft=null; B.gq='';\
  render(); scrollToCatat();\
  toast('QRIS gabungan tersimpan: '+sel.length+' pedagang.', 'okk');\
\}\
function submitRekap()\{\
  const B = UI.bayar; const pos = IX.pelMap.get($('#r-pos').value);\
  const nominal = parseNum($('#f-nominal').value), tanggal = $('#f-tanggal').value, nomor = normRef(($('#f-nomor').value||'').trim()), ket = ($('#r-ket').value||'').trim();\
  const err = msg => \{ B.draft = \{nominal, tanggal, nomor, ket\}; fieldErr('f-err', msg); \};\
