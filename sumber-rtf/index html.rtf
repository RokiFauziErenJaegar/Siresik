    openSheet(`$\{sheetHead('Pilih pelanggan', `Mutasi <span class="mono">$\{esc(m.ref)\}</span> \'b7 $\{rp(m.nominal)\} \'b7 $\{tglS(m.tanggal)\}`)\}\
      <div class="sh-body"><div class="sw">$\{ICON.search\}<input id="as-q" class="inp big" type="search" placeholder="Cari nama atau kode pelanggan" data-inp="asq" data-mid="$\{m.id\}" autocomplete="off"></div><div id="asRes" class="res" style="margin-top:0"></div></div>`);\
