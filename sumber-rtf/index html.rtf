      <select class="inp" data-chg="riw" data-k="ptg" aria-label="Petugas"><option value="">Semua petugas</option>$\{S.petugas.map(k=>`<option value="$\{k.id\}" $\{R.ptg===k.id?'selected':''\}>$\{esc(k.nama)\}</option>`).join('')\}</select>\
    </div>\
