  --em-950:#022C22; --em-900:#064E3B; --em-800:#065F46; --em-700:#047857; --em-600:#059669; --em-500:#10B981; --em-400:#34D399; --em-300:#6EE7B7; --em-200:#A7F3D0; --em-100:#D1FAE5; --em-50:#ECFDF5;\
  --blue-800:#1E40AF; --blue-700:#1D4ED8; --blue-600:#2563EB; --blue-200:#BFDBFE; --blue-50:#EFF6FF;\
  --rose-800:#9F1239; --rose-700:#BE123C; --rose-600:#E11D48; --rose-500:#F43F5E; --rose-200:#FECDD3; --rose-100:#FFE4E6; --rose-50:#FFF1F2;\
  --amber-800:#92400E; --amber-700:#B45309; --amber-400:#FBBF24; --amber-200:#FDE68A; --amber-100:#FEF3C7; --amber-50:#FFFBEB;\
  --orange-800:#9A3412; --orange-700:#C2410C; --orange-500:#F97316; --orange-200:#FED7AA; --orange-100:#FFEDD5; --orange-50:#FFF7ED;\
  --rolebar:#044030; --on-dark:#FFFFFF; --code-bg:#1E293B; --code-line:#334155; --code-fg:#F1F5F9; --code-muted:#CBD5E1;\
  /* nama semantik dipakai di skrip */\
  --brand:var(--em-500); --brand-ink:var(--em-700); --brand-soft:var(--em-50);\
  --ok:var(--em-700); --ok-soft:var(--em-100); --ok-bar:var(--em-500);\
  --wait:var(--amber-700); --wait-soft:var(--amber-100); --wait-bar:var(--amber-400);\
  --bad:var(--rose-700); --bad-soft:var(--rose-100); --bad-bar:var(--rose-500);\
  --warn:var(--orange-700); --warn-soft:var(--orange-100); --warn-bar:var(--orange-500);\
