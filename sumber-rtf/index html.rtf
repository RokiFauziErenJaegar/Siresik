.i-ok\{--c:var(--em-500);--ct:var(--em-700);--cs:var(--em-100);--ct2:var(--em-800)\}\
.i-bad\{--c:var(--rose-500);--ct:var(--rose-700);--cs:var(--rose-100);--ct2:var(--rose-800)\}\
.i-wait\{--c:var(--amber-400);--ct:var(--amber-700);--cs:var(--amber-100);--ct2:var(--amber-800)\}\
.i-warn\{--c:var(--orange-500);--ct:var(--orange-700);--cs:var(--orange-100);--ct2:var(--orange-800)\}\
.real-head\{display:flex;justify-content:space-between;align-items:flex-start;gap:10px\}\
.real-pct\{font-size:15px;font-weight:900;color:var(--em-700);text-align:right;line-height:1.25\}\
