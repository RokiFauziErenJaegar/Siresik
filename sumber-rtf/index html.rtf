const imporAlamat = (r, wil) => r.alamat ? (/,/.test(r.alamat) || /jl\\.|jalan/i.test(r.alamat) ? r.alamat : r.alamat+', '+wil) : wil;\
function imporTarif(r, I)\{\
  const kat = r.kat && katInfo(r.kat).id===r.kat ? r.kat : I.kat;\
  const k = katInfo(kat);\
  if(k.bebas) return r.tarif || 0;\
  const sk = r.skala && skalaInfo(kat, r.skala) ? r.skala : (kat===I.kat ? I.skala : (k.skala[0]||[''])[0]);\
