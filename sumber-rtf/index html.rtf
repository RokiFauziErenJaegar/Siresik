      <select class="inp" data-chg="pelf" data-k="kat" aria-label="Filter jenis tarif"><option value="">Semua jenis tarif</option><option value="bulan" $\{F.kat==='bulan'?'selected':''\}>Bulanan</option><option value="hari" $\{F.kat==='hari'?'selected':''\}>Harian (Rp2.000/hari)</option></select>\
      <select class="inp" data-chg="pelf" data-k="st" aria-label="Filter status"><option value="">Semua status</option><option value="LUNAS" $\{F.st==='LUNAS'?'selected':''\}>Sudah bayar</option><option value="MENUNGGU" $\{F.st==='MENUNGGU'?'selected':''\}>Menunggu verifikasi</option><option value="BELUM" $\{F.st==='BELUM'?'selected':''\}>Belum bayar</option><option value="NUNGGAK" $\{F.st==='NUNGGAK'?'selected':''\}>Menunggak \uc0\u8805  3 bulan</option>$\{nCek?`<option value="CEK" $\{F.st==='CEK'?'selected':''\}>Tarif perlu dicek ($\{nCek\})</option>`:''\}<option value="NONAKTIF" $\{F.st==='NONAKTIF'?'selected':''\}>Nonaktif</option></select>\
    </div>\
  </div>\
  <p class="muted small" id="pelCount"></p>\
  </div>\
  <div id="pelList"></div>`;\
\}\
function filteredPel()\{\
  const F = UI.pel, q = F.q.trim().toLowerCase();\
  return visiblePel().filter(p=>\{\
    if(F.wil && p.wilayah!==F.wil) return false;\
    if(F.ptg && p.ptg!==F.ptg) return false;\
    if(F.kat && (p.satuan||'bulan')!==F.kat) return false;\
    if(F.st==='NONAKTIF')\{ if(p.aktif) return false; \}\
    else if(F.st==='NUNGGAK')\{ if(!p.aktif || tunggakan(p,CUR,true)<3) return false; \}\
    else if(F.st==='CEK')\{ if(!p.cek) return false; \}\
    else if(F.st)\{ if(!p.aktif || stKini(p)!==F.st) return false; \}\
    if(q && !(p.nama.toLowerCase().includes(q) || p.kode.toLowerCase().includes(q) || p.kode.replace('PSW-','').includes(q) || (p.alamat||'').toLowerCase().includes(q) || (p.usaha||'').toLowerCase().includes(q))) return false;\
    return true;\
  \});\
\}\
