        rows.push(\{bulan:blnLabel(per), bayar:new Set(bs.filter(b=>!b.rekap && !b.harian).map(b=>b.pel)).size, ped:sum(bs.filter(b=>b.harian),b=>b.hari||0), potensi:pot, tot, file:sum(bs.filter(b=>b.sumber==='FILE'),b=>b.nominal), lunas, pct: pot?Math.round(tot/pot*100):0\});\
      \}\
