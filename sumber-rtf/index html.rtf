    $\{b.status==='LUNAS'?'<div class="note note-warn">Pembayaran ini sudah diverifikasi. Pembatalan akan memengaruhi rekonsiliasi tanggal '+tgl(b.tanggal)+'.</div>':''\}\
    $\{b.batch && !b.harian?'<div class="note note-warn">Pedagang ini bagian dari QRIS gabungan. Total QRIS gabungan ikut berkurang sehingga bisa tidak cocok lagi dengan mutasi rekening.</div>':''\}\
    <div class="field"><label for="batal-alasan">Alasan</label><textarea id="batal-alasan" class="inp" placeholder="Wajib diisi. Contoh: salah pilih pelanggan, nomor referensi salah ketik."></textarea></div>\
    <p class="note note-bad" id="batal-err" hidden></p>\
    $\{b.rekap ? '' : `<button class="btn btn-block" data-act="batal-do" data-id="$\{b.id\}" data-mode="koreksi">Batalkan &amp; catat ulang</button>`\}\
    <button class="btn btn-warn btn-block" data-act="batal-do" data-id="$\{b.id\}" data-mode="batal">Batalkan saja</button>\
  </div>`;\
  openSheet(html);\
\}\
