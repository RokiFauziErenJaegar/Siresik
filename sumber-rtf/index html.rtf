  const okB = b => b.status!=='BATAL' && (!L.wil || wilB(b)===L.wil) && (!L.ptg || b.ptg===L.ptg);\
  const okP = p => (!L.wil || p.wilayah===L.wil) && (!L.ptg || p.ptg===L.ptg);\
