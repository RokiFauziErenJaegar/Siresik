  const bisaBayar = p.aktif && can.input() && (h ? s==='BELUM' : tl.length);\
  const html = `$\{sheetHead(p.nama, `$\{p.kode\} \'b7 $\{esc(katNama(p))\}`)\}\
  <div class="sh-body">\
    <div class="row-btns" style="align-items:center">$\{chip(s, stTxt)\}$\{tl.length>1?chip('BELUM', tl.length+' bulan belum dibayar'):''\}$\{h?chip('HARIAN', stBulan(p,CUR).hari+' hari dibayar '+blnS(CUR)):''\}</div>\
    $\{bisaBayar || (waOk(p) && tl.length) ? `<div class="row-btns">$\{bisaBayar?`<button class="btn btn-blue" data-act="bay-dari-pel" data-kode="$\{p.kode\}">$\{ICON.qr\}Catat Bukti QRIS</button>`:''\}$\{waOk(p) && tl.length?`<a class="btn btn-line" href="$\{esc(waLink(p, pesanIngat(p)))\}" target="_blank" rel="noopener">$\{ICON.wa\}Ingatkan via WA</a>`:''\}</div>` : ''\}\
    $\{p.cek ? `<div class="note note-warn small"><b>Tarif perlu dicek.</b> $\{esc(p.ket||'Tarif belum sesuai tabel Perda.')\}</div>` : (p.ket ? `<div class="note note-plain small">$\{esc(p.ket)\}</div>` : '')\}\
    $\{p.rinci && CUR>=p.rinci ? `<div class="note note-plain small">Pembayaran per pelanggan mulai dicatat $\{blnLabel(p.rinci)\}. Bulan sebelumnya hanya ada rekapnya di file setoran bendahara.</div>` : ''\}\
