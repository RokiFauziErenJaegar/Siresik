  'mut-assign-pick': el => \{\
    const m = S.mutasi.find(x=>x.id===el.dataset.mid); const p = IX.pelMap.get(el.dataset.kode); if(!m || !p) return;\
    const ops = []; let grup;\
    if(isHarian(p))\{\
      if(m.nominal % p.tarif)\{ toast('Nominal '+rp(m.nominal)+' bukan kelipatan tarif harian '+rp(p.tarif)+'.', 'bad'); return; \}\
      const pos = posOf(p.wilayah); if(!pos)\{ toast('Pos pasar tidak ditemukan.', 'bad'); return; \}\
      const rec = createHarian(pos, \{[p.kode]: m.nominal/p.tarif\}, \{tanggal:m.tanggal, nomor:m.ref, status:'LUNAS', sumber:'IMPORT', mutasiRef:m.ref\});\
      grup = rec.grup; ops.push(opB(rec));\
    \} else \{\
      const tl = tagihanList(p);\
      let need = 0; const pick = []; for(const t of (tl.length?tl:[\{per:CUR,kurang:p.tarif\}]))\{ if(need>=m.nominal) break; pick.push(t.per); need += t.kurang; \}\
      const r = createPayments(p, alokasi(p, pick.length?pick:[CUR], m.nominal), \{tanggal:m.tanggal, nomor:m.ref, ptg:p.ptg, status:'LUNAS', sumber:'IMPORT', mutasiRef:m.ref\});\
      grup = r.grup; r.recs.forEach(b=>ops.push(opB(b)));\
    \}\
    m.grups = [grup]; ops.push(\{t:'mutasi', row:m\}); reindex();\
    ops.push(audit('Catat QRIS dari mutasi', grup, grupKet(grup), null, \{status:'Lunas', sumber:'Mutasi rekening'\}, ''));\
    commit(ops, 'Catat dari mutasi');\
