/* ---------- LEMBAR & NOTIFIKASI ---------- */\
const sheetHead = (title, sub) => `<div class="sh-head"><div style="min-width:0"><h2 id="sheet-title">$\{esc(title)\}</h2>$\{sub?`<p>$\{sub\}</p>`:''\}</div><button class="icon-btn" data-act="sheet-close" aria-label="Tutup">$\{ICON.x\}</button></div>`;\
let lastFocus = null;\
function openSheet(html)\{\
  if($('#sheet').hidden) lastFocus = document.activeElement;\
  $('#sheetBody').innerHTML = html;\
  $('#sheet').hidden = false;\
  document.body.classList.add('noscroll');\
  $('.sheet-panel').scrollTop = 0;\
  const f = $('#sheetBody .icon-btn'); if(f) f.focus(\{preventScroll:true\});\
\}\
function closeSheet()\{\
  $('#sheet').hidden = true; $('#sheetBody').innerHTML = '';\
  document.body.classList.remove('noscroll');\
  if(lastFocus && document.contains(lastFocus)) lastFocus.focus(\{preventScroll:true\});\
  if(SYNC.dirty) renderSoon();\
\}\
function closeSheetIfOpen()\{ if(!$('#sheet').hidden) closeSheet(); \}\
let toastT = null;\
function toast(msg, kind)\{\
  const t = $('#toast'); t.textContent = msg; t.className = 'toast'+(kind?' t-'+kind:''); t.hidden = false;\
  clearTimeout(toastT); toastT = setTimeout(()=>\{ t.hidden = true; \}, 3800);\
\}\
function auditSheet()\{\
