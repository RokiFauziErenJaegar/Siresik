      total = \{potensi:sum(rows,r=>r.potensi), tot:sum(rows,r=>r.tot), file:sum(rows,r=>r.file), lunas:sum(rows,r=>r.lunas), ped:sum(rows,r=>r.ped)\};\
      total.pct = total.potensi ? Math.round(total.tot/total.potensi*100) : 0;\
