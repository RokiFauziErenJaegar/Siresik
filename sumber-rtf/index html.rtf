function scrollToCatat()\{ const c = $('.steps'); if(c)\{ const y = c.closest('.card').getBoundingClientRect().top + window.scrollY - 70; window.scrollTo(\{top:Math.max(0,y)\}); \} \}\
const fieldErr = (id, msg) => \{ const e = $('#'+id); if(!e) return toast(msg,'bad'); e.textContent = msg; e.hidden = false; e.scrollIntoView(\{block:'center'\}); \};\
async function simpanLangsung(ops)\{\
  if(MODE==='lokal')\{ saveLokal(); return ops.map(o=>(\{t:o.t, row:o.row, asal:o.row[KEYF[o.t]||'id']\})); \}\
  const j = await api('simpan', \{ops\});\
  terimaSimpan(j.rows||[]);\
  return j.rows||[];\
\}\
function kodeLokalBaru()\{ const mx = S.pelanggan.reduce((m,p)=>Math.max(m, +((p.kode.match(/^PSW-(\\d+)$/)||[])[1]||0)), 0); return 'PSW-'+pad(mx+1,4); \}\
function cekNomor(nomor)\{\
  if(!nomor) return 'Isi nomor referensi QRIS dari bukti transaksi.';\
  if(nomor.replace(/[^A-Z0-9]/g,'').length<6) return 'Nomor referensi terlalu pendek. Salin persis dari bukti transaksi.';\
  const dup = refRecs(nomor)[0];\
  if(dup)\{ const j = recJudul(dup); return 'Nomor referensi ini sudah dipakai untuk '+j.nama+' ('+tglS(dup.tanggal)+'). Periksa kembali.'; \}\
  return '';\
\}\
