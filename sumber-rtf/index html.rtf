    && (!R.st || (R.st==='LUNAS'&&b.status==='LUNAS') || (R.st==='MENUNGGU'&&b.status==='MENUNGGU'&&!isCovered(b.tanggal)) || (R.st==='TIDAKADA'&&b.status==='MENUNGGU'&&isCovered(b.tanggal)) || (R.st==='BATAL'&&b.status==='BATAL')));\
  list.sort((a,b)=>(b.tanggal+b.dibuatPada+b.id).localeCompare(a.tanggal+a.dibuatPada+a.id));\
