.b-qris\{background:var(--blue-600)\} .b-tunai\{background:var(--em-500)\} .b-pend\{background:var(--amber-400)\}\
.b-ok\{background:var(--em-500)\} .b-wait\{background:var(--amber-400)\} .b-bad\{background:var(--rose-500)\}\
.plegend\{display:grid;grid-template-columns:1fr 1fr;gap:7px 12px;font-size:12px;color:var(--muted);margin-top:11px\}\
