function rekonRange(from, to, ptg)\{\
  const m = new Map();\
  for(const b of S.bayar)\{\
    if(b.status==='BATAL' || b.tanggal<from || b.tanggal>to) continue;\
    if(ptg && b.ptg!==ptg) continue;\
    const key = b.tanggal+'|'+b.ptg;\
    let e = m.get(key); if(!e)\{ e = \{key, tanggal:b.tanggal, ptg:b.ptg, dipungut:0, masuk:0, g:new Set(), open:[], file:0\}; m.set(key, e); \}\
    e.dipungut += b.nominal; e.g.add(String(b.nomor).toUpperCase());\
    if(b.sumber==='FILE') e.file += b.nominal;\
    if(b.status==='LUNAS') e.masuk += b.nominal; else e.open.push(b);\
  \}\
  const out = [...m.values()];\
  for(const e of out)\{\
    e.n = e.g.size;\
    e.selisih = e.dipungut - e.masuk;\
    e.cover = isCovered(e.tanggal);\
    e.status = e.selisih===0 ? 'OK' : (e.cover ? 'PERIKSA' : 'TUNGGU');\
    e.openR = [...new Set(e.open.map(b=>String(b.nomor).toUpperCase()))];\
    e.alasan = e.status==='TUNGGU' ? 'Mutasi rekening Bank Lampung untuk tanggal ini belum diunggah bendahara.'\
             : e.status==='PERIKSA' ? e.openR.length+' transaksi QRIS yang dicatat tidak ditemukan di mutasi rekening, atau nominalnya berbeda.' : '';\
    e.note = S.notes[e.key] || null;\
  \}\
