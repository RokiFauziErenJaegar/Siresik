async function submitPel(form)\{\
  const kode = form.dataset.kode; const old = kode ? IX.pelMap.get(kode) : null;\
  const kat = $('#pf-kat').value, k = katInfo(kat), skala = k.skala.length ? $('#pf-skala').value : '';\
  const waIn = $('#pf-wa').value.trim();\
  const v = \{nama:$('#pf-nama').value.trim().replace(/\\s+/g,' '), alamat:$('#pf-alamat').value.trim(), wa:(old && waIn===old.wa) ? old.wa : waIn.replace(/\\D/g,''), usaha:$('#pf-usaha').value.trim(),\
    wilayah:$('#pf-wil').value, ptg:$('#pf-ptg').value, kat, skala, satuan:k.satuan, tarif: k.bebas ? parseNum($('#pf-tarif').value) : tarifPerda(kat, skala), aktif:$('#pf-aktif').checked\};\
  const err = msg => fieldErr('pf-err', msg);\
  if(v.nama.length<2) return err('Isi nama pelanggan.');\
  if(v.wa && !(old && v.wa===old.wa) && (v.wa.length<9 || v.wa.length>14)) return err('Nomor WA tidak lengkap. Contoh: 081234567890.');\
  if(!v.tarif) return err('Isi tarif.');\
  const btn = form.querySelector('button[type=submit]'); btn.disabled = true;\
  try\{\
    if(old)\{\
      const alasan = ($('#pf-alasan').value||'').trim();\
      if(alasan.length<5)\{ btn.disabled = false; return err('Tulis alasan perubahan (minimal 5 huruf).'); \}\
      const keys = \{nama:'nama', alamat:'alamat', wa:'wa', usaha:'jenis usaha', wilayah:'wilayah', ptg:'petugas', kat:'jenis tarif', skala:'skala', tarif:'tarif', aktif:'aktif'\};\
      const fmt = (kk,x) => kk==='ptg'?ptgNama(x):kk==='kat'?katInfo(x).nama:kk==='aktif'?(x?'aktif':'nonaktif'):x;\
      const sb = \{\}, ss = \{\};\
      for(const kk of Object.keys(keys))\{ if((old[kk]??'')!==(v[kk]??''))\{ sb[keys[kk]] = fmt(kk, old[kk]); ss[keys[kk]] = fmt(kk, v[kk]); \} \}\
      const cekOk = old.cek && (!!($('#pf-cekok') && $('#pf-cekok').checked) || v.kat!=='KHS' && old.kat==='KHS');\
      if(cekOk)\{ sb['status tarif'] = 'perlu dicek'; ss['status tarif'] = 'sudah dicek'; \}\
      if(!Object.keys(sb).length)\{ btn.disabled = false; return err('Belum ada data yang diubah.'); \}\
      const row = Object.assign(\{\}, old, v); if(cekOk)\{ delete row.cek; delete row.ket; \}\
      await simpanLangsung([\{t:'pelanggan', row\}, audit('Ubah data pelanggan', old.kode, old.kode+' '+old.nama, sb, ss, alasan)]);\
      if(MODE==='lokal')\{ Object.assign(old, v); if(cekOk)\{ delete old.cek; delete old.ket; \} \}\
      closeSheet(); render(); pelDetail(old.kode); toast('Data pelanggan diperbarui.', 'okk');\
    \} else \{\
      const row = Object.assign(\{kode: MODE==='lokal' ? kodeLokalBaru() : 'BARU-'+uid(''), sejak:CUR\}, v);\
      if(MODE==='lokal') S.pelanggan.push(row);\
      const res = await simpanLangsung([\{t:'pelanggan', row\}]);\
      const baru = (res[0] && res[0].row) || row;\
      await simpanLangsung([audit('Tambah pelanggan', baru.kode, baru.kode+' '+baru.nama, null, \{nama:baru.nama, wilayah:baru.wilayah, tarif:tarifLabel(baru)\}, '')]);\
      closeSheet(); render(); pelDetail(baru.kode); toast('Pelanggan '+baru.kode+' ditambahkan.', 'okk');\
    \}\
  \}catch(e)\{ btn.disabled = false; err(e.message); \}\
\}\
async function imporJalankan()\{\
  const I = UI.impor; if(!I || !I.rows) return;\
  const w = wilByNama(I.wil); if(!w) return;\
  const ada = new Set(S.pelanggan.filter(p=>p.wilayah===I.wil).map(p=>(p.nama+'|'+(p.alamat||'')).toLowerCase()));\
  const baru = [];\
  I.rows.forEach(r=>\{\
    const alamat = imporAlamat(r, I.wil);\
    if(ada.has((r.nama+'|'+alamat).toLowerCase())) return;\
    const kat = r.kat || I.kat, k = katInfo(kat);\
    const skala = k.skala.length ? (skalaInfo(kat, r.skala) ? r.skala : (kat===I.kat ? I.skala : k.skala[0][0])) : '';\
    const tarif = k.bebas ? (r.tarif||0) : tarifPerda(kat, skala);\
    if(!tarif) return;\
    baru.push(\{kode:'', nama:r.nama, alamat, wa:r.wa, usaha:r.usaha, wilayah:w.nama, ptg:w.ptg, kat, skala, satuan:k.satuan, tarif, aktif:true, sejak:CUR, src:\{lembar:I.file, no:null\}\});\
  \});\
  if(!baru.length)\{ toast('Tidak ada pelanggan baru untuk diimpor.', 'bad'); return; \}\
  toast('Mengimpor '+baru.length+' pelanggan\'85');\
  try\{\
    if(MODE==='lokal')\{ baru.forEach(p=>\{ p.kode = kodeLokalBaru(); S.pelanggan.push(p); \}); \}\
    else \{\
      for(let i=0;i<baru.length;i+=250)\{ const part = baru.slice(i,i+250).map((p,j)=>(\{t:'pelanggan', row:Object.assign(\{\}, p, \{kode:'BARU-'+uid('')+j\})\})); await simpanLangsung(part); \}\
    \}\
    await simpanLangsung([audit('Impor pelanggan dari Excel', 'impor', baru.length+' pelanggan ke '+w.nama+' dari '+I.file, null, \{jumlah:baru.length\}, '')]);\
    UI.impor = null; closeSheet(); UI.tab = 'pelanggan'; UI.pel.wil = w.nama; render();\
    toast(baru.length+' pelanggan berhasil diimpor ke '+w.nama+'.', 'okk');\
  \}catch(e)\{ toast('Impor berhenti: '+e.message, 'bad'); muatUlang(true); \}\
\}\
