  const lc = lastCover();\
  return `\
  $\{sec('qr', 'Modul QRIS Bank Lampung', 'Impor mutasi', `\
    <div class="note $\{lc>=TODAY?'note-ok':'note-wait'\} small">$\{!lc ? 'Mutasi rekening QRIS belum pernah diunggah.' : lc>=TODAY ? `Mutasi rekening sudah diunggah sampai hari ini ($\{tgl(lc)\}).` : `Mutasi rekening baru diunggah sampai <b>$\{tgl(lc)\}</b>. Unggah mutasi $\{rangeLabel(addDays(lc,1), TODAY)\} untuk mencocokkan pembayaran terbaru.`\}</div>\
    <p class="muted small">Unggah file mutasi QRIS dari Bank Lampung (Excel atau CSV). Aplikasi mencocokkan nomor referensi dan nominal dengan pembayaran yang dicatat petugas, termasuk QRIS gabungan pasar.</p>\
    <div class="row-btns"><label class="btn btn-blue" for="mutasi-file">$\{ICON.upload\} Unggah file mutasi</label></div>\
    <input id="mutasi-file" type="file" accept=".xlsx,.xls,.csv" data-chg="mutasi" hidden>\
    <p class="muted small">Kolom yang dibaca: tanggal, nomor referensi, nominal. Belum tersambung langsung ke sistem Bank Lampung; nanti bisa ditambahkan tanpa mengubah data.</p>\
    $\{UI.mut ? mutResult() : ''\}`)\}\
  $\{lepas.length ? sec('alert', 'Dana masuk belum dipasangkan', lepas.length+' transaksi', `<p class="muted small">Dana ini sudah ada di rekening, tetapi belum diketahui milik pelanggan siapa.</p><div class="alerts">$\{lepas.map(m=>mutRow(m, mutState(m))).join('')\}</div>`) : ''\}\
  <section class="stack-col"><h3>Tidak ada di mutasi \'97 perlu diperiksa <span class="muted">($\{qList.length\})</span></h3>\
    <p class="muted small">Dicatat petugas, tetapi tidak ditemukan di mutasi rekening yang sudah diunggah. Cek bukti transaksinya, atau tekan "Sudah masuk" bila dana sudah Anda pastikan ada di rekening.</p>\
    $\{qHtml || '<div class="empty">Tidak ada. Semua catatan petugas cocok dengan mutasi rekening.</div>'\}\
  </section>\
  $\{sec('history', 'Menunggu mutasi diunggah', `$\{qWait.length\} transaksi \'b7 $\{rp(sum(qWait,x=>sum(x.list,b=>b.nominal)))\}`,\
    qWait.length ? `<p class="muted small">$\{lc?'Dicatat setelah '+tgl(lc)+'. ':''\}Akan cocok otomatis saat mutasi rekening tanggal tersebut diunggah.</p><details class="fold"><summary>Lihat daftar ($\{qWait.length\})</summary><div class="res" style="margin-top:6px">$\{qWait.slice(0,80).map(x=>refItem(x.ref, x.list)).join('')\}</div>$\{qWait.length>80?`<p class="muted small">$\{qWait.length-80\} lainnya ada di tab Riwayat.</p>`:''\}</details>` : '<div class="empty">Tidak ada. Semua pembayaran sudah dicocokkan.</div>')\}`;\
\}\
function vRiwayat()\{\
