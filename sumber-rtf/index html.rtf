const katOptions = sel => \{ let h = '', g = ''; KATEGORI.forEach(k=>\{ if(k.grup!==g)\{ if(g) h += '</optgroup>'; g = k.grup; h += `<optgroup label="$\{esc(g)\}">`; \} h += `<option value="$\{k.id\}" $\{k.id===sel?'selected':''\}>$\{esc(k.nama)\}$\{k.satuan==='hari'?' (Rp2.000/hari)':''\}</option>`; \}); return h + '</optgroup>'; \};\
