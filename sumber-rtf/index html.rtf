    if(ops.length)\{ ops.push(audit('Verifikasi QRIS (cek rekening manual)', ref, before, \{status:'Menunggu verifikasi'\}, \{status:'Lunas'\}, '')); commit(ops, 'Verifikasi'); toast(gs.length>1 || refRecs(ref).some(b=>b.harian) ? 'QRIS gabungan diverifikasi. Semua pedagang di dalamnya lunas.' : 'Pembayaran QRIS diverifikasi. Status: Lunas.', 'okk'); \}\
