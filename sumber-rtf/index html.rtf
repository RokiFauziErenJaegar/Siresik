.stack i\{display:block;height:100%\}\
.sboxes\{display:grid;grid-template-columns:1fr 1fr;gap:10px\}\
.sbox\{display:flex;flex-direction:column;gap:2px;min-width:0;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:11px 12px\}\
.sbox>span\{font-size:11px;font-weight:600;color:var(--muted)\}\
.sbox>b\{font-size:clamp(16px,5vw,20px);font-weight:700;color:var(--fg);font-variant-numeric:tabular-nums;overflow-wrap:anywhere;line-height:1.25\}\
.sbox>small\{font-size:10.5px;color:var(--muted-2)\}\
.s-blue\{background:var(--blue-50);border-color:var(--blue-200)\} .s-blue>span\{color:var(--blue-700)\} .s-blue>b\{color:var(--blue-800)\} .s-blue>small\{color:var(--blue-600)\}\
.s-em\{background:var(--em-50);border-color:var(--em-200)\} .s-em>span\{color:var(--em-700)\} .s-em>b\{color:var(--em-800)\} .s-em>small\{color:var(--em-600)\}\
.s-total>b\{color:var(--em-700)\}\
.money-num\{font-size:clamp(24px,7.5vw,30px);font-weight:900;letter-spacing:-.025em;font-variant-numeric:tabular-nums;line-height:1.15;margin-top:2px\}\
.split-rows\{display:grid;grid-template-columns:1fr 1fr;gap:10px\}\
.split-rows>div\{display:flex;flex-direction:column;gap:2px;min-width:0\}\
.split-rows b\{font-size:17px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere\}\
.key\{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--muted)\}\
.sq\{width:10px;height:10px;border-radius:50%;display:inline-block\}\
.sq.qris\{background:var(--blue-600)\} .sq.tunai\{background:var(--em-500)\}\
.kol-list\{display:flex;flex-direction:column\}\
.kol-row\{display:flex;flex-direction:column;gap:8px;padding:13px 14px;border-top:1px solid var(--surface-2)\}\
.kol-row:first-child\{border-top:0\}\
.kol-grp\{padding:9px 14px;background:var(--surface-3);border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:10.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)\}\
.kol-list .kol-grp:first-child\{border-top:0\}\
.kol-grp+.kol-row\{border-top:0\}\
.pill-file\{background:var(--amber-100);color:var(--amber-800);font-weight:700\}\
\
.kol-top\{display:flex;align-items:center;justify-content:space-between;gap:8px\}\
.kol-name\{display:flex;align-items:center;gap:7px;flex-wrap:wrap;min-width:0\}\
.kol-name b\{font-size:15px;font-weight:700\}\
.pill\{display:inline-block;font-size:10.5px;font-weight:500;color:var(--fg-2);background:var(--surface-2);padding:2px 8px;border-radius:999px\}\
.pct-pill\{font-size:12.5px;font-weight:800;padding:4px 9px;border-radius:8px;background:var(--blue-50);color:var(--blue-700);white-space:nowrap;font-variant-numeric:tabular-nums\}\
.kol-meta\{display:flex;flex-wrap:wrap;gap:3px 12px;font-size:12px;color:var(--muted)\}\
.kol-meta b\{font-variant-numeric:tabular-nums;color:var(--fg)\}\
.kol-meta b.t-blue\{color:var(--blue-700)\} .kol-meta b.t-em\{color:var(--em-700)\} .kol-meta b.t-wait\{color:var(--amber-700)\} .kol-meta b.t-bad\{color:var(--rose-700)\}\
.kol-foot\{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12px;color:var(--muted);flex-wrap:wrap\}\
.alerts\{display:flex;flex-direction:column;gap:8px\}\
.alert\{display:flex;align-items:flex-start;gap:10px;width:100%;text-align:left;padding:10px 12px;border-radius:10px;border:1px solid var(--line);border-left-width:4px;font-size:13px;line-height:1.4;color:var(--fg-2);background:var(--surface)\}\
.alert .dot\{margin-top:5px\}\
.alert b\{font-weight:700;color:var(--fg)\}\
button.alert:hover\{filter:brightness(.98)\}\
.alert.a-warn\{background:var(--orange-50);border-color:var(--orange-200);border-left-color:var(--orange-500)\}\
.alert.a-wait\{background:var(--amber-50);border-color:var(--amber-200);border-left-color:var(--amber-400)\}\
.alert.a-ok\{background:var(--em-50);border-color:var(--em-200);border-left-color:var(--em-500)\}\
.alert.a-plain\{background:var(--surface-3);border-left-color:var(--line-2)\}\
.bars\{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:5px;height:150px\}\
.bar-col\{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0\}\
.bar-val\{font-size:10px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--muted)\}\
.bar-track\{flex:1;width:100%;display:flex;align-items:flex-end;background:var(--surface-2);border-radius:6px;overflow:hidden\}\
.bar-track i\{display:block;width:100%;background:var(--em-500);border-radius:6px 6px 0 0\}\
.bar-col.cur .bar-track i\{background:var(--em-700)\}\
.bar-col.cur .bar-val\{color:var(--fg)\}\
.bar-lbl\{font-size:10.5px;color:var(--muted);font-weight:600\}\
.quick\{display:grid;grid-template-columns:1fr 1fr;gap:10px\}\
.quick .btn\{min-height:54px;font-size:13.5px;line-height:1.25;padding:0 12px\}\
\
/* Tabel */\
.tbl-wrap\{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface);-webkit-overflow-scrolling:touch;box-shadow:var(--sh-sm)\}\
.tbl\{width:100%;border-collapse:collapse;font-size:13px\}\
.tbl th\{position:sticky;top:0;background:var(--surface-3);text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:9px 10px;font-weight:700;white-space:nowrap;border-bottom:1px solid var(--line)\}\
.tbl td\{padding:10px;border-top:1px solid var(--surface-2);vertical-align:middle\}\
.tbl tbody tr:first-child td\{border-top:0\}\
.tbl tr[data-act]\{cursor:pointer\}\
.tbl tr[data-act]:hover td,.tbl tr[data-act]:focus-visible td\{background:var(--surface-3)\}\
.tbl tfoot td\{font-weight:800;background:var(--em-50);border-top:1px solid var(--em-200)\}\
.tbl .r\{text-align:right\}\
.tbl .nw\{white-space:nowrap\}\
.tbl-pel td,.tbl-pel th\{padding:9px 8px\}\
.tbl-pel td:first-child\{min-width:110px\}\
.nm\{font-weight:700;line-height:1.25;color:var(--fg)\}\
.kd\{font-family:var(--mono);font-size:10.5px;color:var(--muted-2);margin-top:2px;font-weight:600\}\
.rep-tbl td\{white-space:nowrap\}\
.rep-tbl td.wrap-cell\{white-space:normal;min-width:180px\}\
.more\{display:flex;justify-content:center;padding-top:10px\}\
\
/* Daftar */\
.res\{display:flex;flex-direction:column;gap:8px;margin-top:12px\}\
.item\{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:12px;background:var(--surface);text-align:left;color:var(--fg)\}\
button.item:hover\{border-color:var(--em-500);background:var(--em-50)\}\
.item-main\{display:flex;flex-direction:column;gap:2px;min-width:0\}\
.item-main b\{font-weight:700;line-height:1.3\}\
.item-main span\{font-size:12px;color:var(--muted)\}\
.item-side\{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex:none\}\
.item-side b\{font-weight:800;font-variant-numeric:tabular-nums\}\
.item.is-batal b\{text-decoration:line-through;color:var(--muted)\}\
.qitem\{flex-direction:column;align-items:stretch;gap:10px\}\
.qi-top\{display:flex;justify-content:space-between;align-items:flex-start;gap:10px\}\
.qi-top>b\{font-weight:800;flex:none\}\
.qi-btns\{display:grid;grid-template-columns:1fr 1fr;gap:8px\}\
.paybtns.one\{grid-template-columns:1fr\}\
.gab-item\{cursor:pointer;justify-content:flex-start\}\
.gab-item input\{width:22px;height:22px;margin:0;accent-color:var(--em-600);flex:none\}\
.gab-item .item-main\{flex:1\}\
.gab-item.on\{border-color:var(--em-500);background:var(--em-50)\}\
.qhead\{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--blue-800)\}\
\
.paybtn small\{text-align:center;padding:0 14px;line-height:1.35\}\
.empty\{padding:18px;text-align:center;color:var(--muted);font-size:13.5px;border:1px dashed var(--line-2);border-radius:12px;background:var(--surface)\}\
.seg\{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:4px;padding:4px;border-radius:12px;background:var(--line)\}\
.seg button\{min-height:42px;border:0;border-radius:9px;background:transparent;font-weight:700;font-size:13.5px;color:var(--muted);display:flex;align-items:center;justify-content:center;gap:6px\}\
.seg button.on\{background:var(--surface);color:var(--em-800);box-shadow:var(--sh-sm)\}\
.seg .cnt\{min-width:20px;height:20px;padding:0 6px;border-radius:10px;background:var(--amber-400);color:var(--amber-800);font-size:11px;line-height:20px\}\
.chips\{display:flex;gap:6px;flex-wrap:wrap\}\
.fchip\{min-height:36px;padding:0 13px;border-radius:999px;border:1px solid var(--line-2);background:var(--surface);font-weight:600;font-size:13px;color:var(--fg-2)\}\
.fchip[aria-pressed="true"]\{border-color:var(--em-600);background:var(--em-600);color:var(--on-dark)\}\
\
/* Alur pembayaran */\
.steps\{display:flex;gap:8px;list-style:none;padding:0;margin:0 0 14px;counter-reset:s\}\
.steps li\{flex:1;display:flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;color:var(--muted-2);text-transform:uppercase;letter-spacing:.04em;line-height:1.2;counter-increment:s;min-width:0\}\
.steps li::before\{content:counter(s);width:22px;height:22px;border-radius:50%;background:var(--surface-2);color:var(--muted);display:flex;align-items:center;justify-content:center;font-size:11px;flex:none\}\
.steps li.on\{color:var(--em-800)\}\
.steps li.on::before\{background:var(--em-700);color:var(--on-dark)\}\
.steps li.done\{color:var(--em-700)\}\
.steps li.done::before\{content:"\uc0\u10003 ";background:var(--em-100);color:var(--em-700)\}\
.pel-box\{display:grid;grid-template-columns:1fr 1fr;gap:10px 12px;padding:12px;border-radius:10px;background:var(--em-50);border:1px solid var(--em-200)\}\
.pel-box>div\{display:flex;flex-direction:column;gap:1px;min-width:0\}\
.pel-box span\{font-size:10px;font-weight:700;color:var(--muted-2);text-transform:uppercase;letter-spacing:.04em\}\
.pel-box b\{font-size:14px;font-weight:700;overflow-wrap:anywhere;line-height:1.3\}\
.pel-box b.tarif\{font-size:16px;font-weight:900;color:var(--em-700)\}\
.pel-box .full\{grid-column:1 / -1\}\
.mchips\{display:flex;flex-wrap:wrap;gap:8px\}\
.mchip\{display:flex;flex-direction:column;align-items:flex-start;min-height:52px;padding:6px 12px;border-radius:10px;border:2px solid var(--line-2);background:var(--surface);font-weight:800;font-size:13.5px;line-height:1.25;color:var(--fg)\}\
.mchip small\{font-weight:600;font-size:11px;color:var(--muted)\}\
.mchip[aria-pressed="true"]\{border-color:var(--em-600);background:var(--em-50);color:var(--em-800)\}\
.mchip[aria-pressed="true"] small\{color:var(--em-700)\}\
.total-line\{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:12px 0;border-top:1px dashed var(--line-2);border-bottom:1px dashed var(--line-2)\}\
.total-line b\{font-size:22px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--fg)\}\
.success\{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;padding:6px 0 4px\}\
.success .big-ico\{width:62px;height:62px;border-radius:50%;background:var(--em-100);color:var(--em-700);display:flex;align-items:center;justify-content:center\}\
.success .big-ico svg\{width:32px;height:32px;stroke-width:2.6\}\
.kv\{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13.5px;width:100%;text-align:left\}\
.kv dt\{color:var(--muted)\}\
.kv dd\{margin:0;font-weight:700;text-align:right;overflow-wrap:anywhere\}\
.cash\{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap\}\
.cash-num\{font-size:26px;font-weight:900;letter-spacing:-.02em;font-variant-numeric:tabular-nums\}\
\
/* Rekonsiliasi */\
.formula-box\{background:var(--slate-900);color:var(--code-muted);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:8px;box-shadow:var(--sh-sm)\}\
.formula-box .ft\{color:var(--amber-400);font-size:11.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase\}\
.formula-box code\{display:block;font-family:var(--mono);font-size:12.5px;background:var(--code-bg);border:1px solid var(--code-line);border-radius:8px;padding:8px 10px;color:var(--code-fg);overflow-wrap:anywhere\}\
.formula-box .fr\{display:flex;gap:8px;align-items:flex-start;font-size:12px;line-height:1.4\}\
.formula-box .fr i\{width:9px;height:9px;border-radius:50%;margin-top:4px;flex:none\}\
.formula-box b\{color:var(--on-dark)\}\
.datebar\{display:flex;align-items:center;gap:8px\}\
.datebar .inp\{flex:1;min-height:44px;font-weight:700\}\
.daysum\{display:grid;grid-template-columns:repeat(3,1fr);gap:8px\}\
.daysum>div\{padding:10px 12px;border-radius:12px;background:var(--surface);border:1px solid var(--line);min-width:0;box-shadow:var(--sh-sm)\}\
.daysum>div\{padding:10px\}\
.daysum b\{display:block;font-size:clamp(12px,3.3vw,15px);font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap;margin-top:2px\}\
.rek\{padding:0;overflow:hidden;border-left:4px solid var(--c,var(--line-2))\}\
.rek.s-ok\{--c:var(--em-500)\} .rek.s-wait\{--c:var(--amber-400)\} .rek.s-warn\{--c:var(--orange-500)\}\
.rek-head\{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px 6px\}\
.rek-head b\{font-size:16px;font-weight:700\}\
.rek-head span\{font-size:12px;color:var(--muted)\}\
.rek-dl\{margin:0;padding:0 14px 8px\}\
.rek-dl>div\{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:7px 0;border-top:1px dashed var(--line)\}\
.rek-dl dt\{color:var(--muted);font-size:13.5px\}\
.rek-dl dd\{margin:0;font-family:var(--mono);font-weight:600;font-size:13.5px;font-variant-numeric:tabular-nums;text-align:right;color:var(--fg)\}\
.rek-dl dd.t-blue\{color:var(--blue-700)\} .rek-dl dd.t-em\{color:var(--em-700)\}\
.rek-dl .sum dt\{color:var(--fg);font-weight:700\}\
.rek-dl .sum dd\{font-weight:800\}\
.rek-dl .sel dt\{color:var(--fg);font-weight:700\}\
.rek-dl .sel dd\{font-weight:800\}\
.rek-body\{padding:0 14px 12px;display:flex;flex-direction:column;gap:8px\}\
.rek-status\{padding:10px 14px;font-weight:800;letter-spacing:.06em;font-size:12.5px\}\
.rs-ok\{background:var(--em-100);color:var(--em-800)\}\
.rs-wait\{background:var(--amber-100);color:var(--amber-800)\}\
.rs-warn\{background:var(--orange-100);color:var(--orange-800)\}\
.rek-empty\{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 14px\}\
\
/* Lembar bawah (rincian) */\
.sheet\{position:fixed;inset:0;z-index:50\}\
.sheet-bg\{position:absolute;inset:0;background:var(--overlay)\}\
.sheet-panel\{position:absolute;left:0;right:0;bottom:0;margin:0 auto;max-width:780px;max-height:92%;overflow:auto;background:var(--surface);border-radius:18px 18px 0 0;padding-top:6px;padding-bottom:calc(24px + env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));box-shadow:var(--shadow);animation:sheetUp .2s ease-out\}\
@keyframes sheetUp\{from\{transform:translateY(24px);opacity:.6\}to\{transform:none;opacity:1\}\}\
@media (prefers-reduced-motion:reduce)\{.sheet-panel\{animation:none\}\}\
.sheet-grip\{width:44px;height:5px;border-radius:3px;background:var(--line-2);margin:4px auto 0\}\
.sh-head\{position:sticky;top:-6px;z-index:2;background:var(--surface);display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--surface-2);margin-bottom:12px\}\
.sh-head p\{font-size:12.5px;color:var(--muted);margin-top:3px\}\
.sh-body\{display:flex;flex-direction:column;gap:14px\}\
.mgrid\{display:grid;grid-template-columns:repeat(4,1fr);gap:6px\}\
.mcell\{display:flex;flex-direction:column;gap:1px;padding:8px 8px 9px;border-radius:10px;font-size:11px;line-height:1.3;min-width:0;border:1px solid transparent\}\
.mcell b\{font-size:13px\}\
.m-ok\{background:var(--em-50);color:var(--em-800);border-color:var(--em-200)\}\
.m-wait\{background:var(--amber-50);color:var(--amber-800);border-color:var(--amber-200)\}\
.m-bad\{background:var(--rose-50);color:var(--rose-800);border-color:var(--rose-200)\}\
.m-fut\{background:var(--surface-3);color:var(--muted-2);border:1px dashed var(--line-2)\}\
.info\{display:grid;grid-template-columns:1fr;border:1px solid var(--line);border-radius:12px;background:var(--surface);overflow:hidden\}\
.info>div\{display:flex;justify-content:space-between;gap:14px;padding:10px 13px;border-top:1px solid var(--surface-2);font-size:13.5px\}\
.info>div:first-child\{border-top:0\}\
.info span\{color:var(--muted);flex:none\}\
.info b\{text-align:right;overflow-wrap:anywhere;font-weight:600\}\
.wa\{display:flex;align-items:center;gap:8px;justify-content:flex-end;flex-wrap:wrap\}\
.audit\{display:flex;flex-direction:column;gap:8px\}\
.audit-item\{padding:10px 12px;border-radius:10px;background:var(--surface-3);border:1px solid var(--line);font-size:12.5px;display:flex;flex-direction:column;gap:3px\}\
.audit-item .meta\{color:var(--muted);font-size:11.5px\}\
.audit-item .diff\{font-family:var(--mono);font-size:11.5px;overflow-wrap:anywhere;color:var(--fg-2)\}\
details.fold summary\{cursor:pointer;font-weight:700;font-size:13.5px;padding:6px 0;color:var(--em-700)\}\
.mut-sum\{display:flex;flex-wrap:wrap;gap:6px\}\
\
/* Notifikasi */\
.toast\{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(80px + env(safe-area-inset-bottom,0px));z-index:70;width:max-content;max-width:min(calc(100vw - 32px),520px);background:var(--slate-900);color:var(--on-dark);padding:11px 15px;border-radius:10px;font-weight:600;font-size:13.5px;box-shadow:var(--shadow)\}\
.toast.t-bad\{background:var(--rose-700)\}\
.toast.t-okk\{background:var(--em-700)\}\
\
@media (min-width:640px)\{\
  .inds,.tiles\{grid-template-columns:repeat(4,1fr)\}\
  .tiles.two\{grid-template-columns:1fr 1fr\}\
  .sboxes\{grid-template-columns:repeat(3,1fr)\}\
  .plegend\{grid-template-columns:repeat(4,auto);justify-content:space-between\}\
\}\
\
/* ===== Tambahan versi siap pakai: login, sinkron, harian, tata letak komputer ===== */\
[hidden]\{display:none!important\}\
.sel-sm\{min-height:38px;font-size:13.5px;font-weight:600;width:auto;padding:0 8px\}\
.btn-hero\{min-height:60px;font-size:16px\}\
.btn-big\{min-height:56px;font-size:16px\}\
.row-btns.tight .btn\{flex:0 0 auto\}\
.inds.two\{grid-template-columns:1fr 1fr!important\}\
.cols,.col\{display:flex;flex-direction:column;gap:14px;min-width:0\}\
.who\{max-width:150px\}\
.who>span\{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0\}\
.who svg:first-child\{width:17px;height:17px;flex:none;color:var(--em-200)\}\
.who svg:last-child\{flex:none\}\
@media (max-width:767px)\{ .hbtn\{display:none!important\} \}\
\
/* indikator penyimpanan di pita peran */\
.sync\{font-size:10.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1 1 0;text-align:right;font-weight:600\}\
.sync::before\{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:1px;background:currentColor\}\
.sync.s-ok\{color:var(--em-300)\} .sync.s-wait\{color:var(--amber-200)\} .sync.s-bad\{color:var(--rose-200)\}\
.note-http\{background:var(--rose-700);color:#fff;font-size:12.5px;font-weight:600;text-align:center;padding:6px 16px\}\
\
/* layar masuk */\
#masuk\{min-height:100vh;min-height:100dvh;background:linear-gradient(160deg,var(--em-900),var(--em-700));display:flex;align-items:center;justify-content:center;padding:24px 16px\}\
.login\{width:100%;max-width:420px;display:flex;flex-direction:column;gap:14px\}\
.login-card\{background:var(--surface);border-radius:18px;padding:22px 18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:16px\}\
.login-brand\{display:flex;gap:12px;align-items:center\}\
.login-brand .logo\{width:46px;height:46px;border-radius:12px;color:#fff\}\
.login-brand .logo svg\{width:24px;height:24px\}\
.login-brand b\{display:block;font-size:19px;font-weight:900;color:var(--em-800);letter-spacing:-.01em\}\
.login-brand span\{display:block;font-size:12.5px;color:var(--muted);line-height:1.35\}\
.login-foot\{color:var(--em-100);font-size:12px;text-align:center;line-height:1.5\}\
