const loaded = \{\};\
function loadScript(src)\{\
  if(loaded[src]) return loaded[src];\
  loaded[src] = new Promise((res,rej)=>\{ const s = document.createElement('script'); s.src = src; s.onload = ()=>res(); s.onerror = ()=>\{ delete loaded[src]; rej(new Error('load')); \}; document.head.appendChild(s); \});\
  return loaded[src];\
\}\
const pdfSafe = s => String(s).replace(/\uc0\u8722 /g,'-').replace(/[\'96\'97]/g,'-').replace(/\'85/g,'...').replace(/\u8594 /g,'->').replace(/\u8805 /g,'>=').replace(/\'b3/g,'3');\
async function unduh(filename, data, mime, okMsg)\{\
  if(window.claude && typeof window.claude.use==='function')\{\
    let dl = null; try\{ dl = await window.claude.use('downloads'); \}catch(e)\{\}\
    if(dl)\{\
      try\{ await dl.save(\{filename, data\}); toast(okMsg, 'okk'); return true; \}\
      catch(e)\{ if(e && e.code==='declined')\{ toast('Unduhan dibatalkan.'); return false; \} \}\
    \}\
  \}\
  try\{\
    const blob = data instanceof Blob ? data : new Blob([data], \{type: mime || 'application/octet-stream'\});\
    const url = URL.createObjectURL(blob); const a = document.createElement('a');\
    a.href = url; a.download = filename; document.body.appendChild(a); a.click();\
    setTimeout(()=>\{ URL.revokeObjectURL(url); a.remove(); \}, 3000);\
    toast(okMsg, 'okk'); return true;\
  \}catch(e)\{ toast('Unduhan tidak tersedia di tampilan ini.', 'bad'); return false; \}\
\}\
