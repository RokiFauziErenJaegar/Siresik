/* ---------- LAPORAN ---------- */\
const REPORTS = [\
  \{id:'harian', nama:'Laporan harian', f:['range','wil','ptg']\},\
  \{id:'bulanan', nama:'Laporan bulanan', f:['wil','ptg']\},\
  \{id:'rekap', nama:'Rekap setoran per pos (seperti lembar REKAP)', f:['tahun']\},\
  \{id:'perpel', nama:'Pembayaran per pelanggan bulanan', f:['bulan','wil','ptg']\},\
  \{id:'harianpel', nama:'Pedagang harian per bulan', f:['bulan','wil','ptg']\},\
  \{id:'perptg', nama:'Kinerja per petugas monitor', f:['bulan']\},\
  \{id:'belum', nama:'Pelanggan belum bayar', f:['bulan','wil','ptg']\},\
  \{id:'mutasi', nama:'Mutasi QRIS Bank Lampung yang diunggah', f:['range']\},\
  \{id:'selisih', nama:'Selisih rekonsiliasi', f:['range','ptg','hanya']\},\
  \{id:'audit', nama:'Riwayat perubahan data', f:['range']\},\
];\
function vLaporan()\{\
  const L = UI.lap, R = REPORTS.find(r=>r.id===L.type), f = R.f;\
  const rep = buildReport();\
  const lim = 300;\
  const head = rep.cols.map(c=>`<th class="$\{['rp','int','pct'].includes(c.t)?'r':''\}">$\{esc(c.h)\}</th>`).join('');\
  const rows = rep.rows.slice(0,lim).map(r=>`<tr>$\{rep.cols.map(c=>`<td class="$\{['rp','int','pct'].includes(c.t)?'r num':''\} $\{c.t==='wrap'?'wrap-cell':''\}">$\{cellHtml(r[c.k],c.t)\}</td>`).join('')\}</tr>`).join('');\
  const foot = rep.total ? `<tfoot><tr>$\{rep.cols.map((c,i)=>`<td class="$\{['rp','int','pct'].includes(c.t)?'r num':''\}">$\{i===0?'TOTAL':(rep.total[c.k]!=null?cellHtml(rep.total[c.k],c.t):'')\}</td>`).join('')\}</tr></tfoot>` : '';\
  const years = []; for(let y=+MULAI.slice(0,4); y<=YEAR; y++) years.push(y);\
  return `\
  <div class="page-title col">\
    <div><h2>Laporan Retribusi Persampahan</h2><p>Rekapitulasi penerimaan DLH Kabupaten Pringsewu</p></div>\
    <div class="row-btns exp-btns"><button class="btn btn-dark" data-act="exp" data-f="xlsx">$\{ICON.table\}EXPORT EXCEL</button><button class="btn btn-rose" data-act="exp" data-f="pdf">$\{ICON.file\}EXPORT PDF</button></div>\
  </div>\
  <section class="card stack-col">\
  <span class="lbl">Filter laporan</span>\
  <div class="field"><label for="lap-type">Jenis laporan</label><select id="lap-type" class="inp big" data-chg="lap" data-k="type">$\{REPORTS.map(r=>`<option value="$\{r.id\}" $\{r.id===L.type?'selected':''\}>$\{esc(r.nama)\}</option>`).join('')\}</select></div>\
  <div class="filters">\
    $\{f.includes('range')?`<div class="field"><label for="lap-dari" class="small">Dari tanggal</label><input id="lap-dari" class="inp" type="date" max="$\{TODAY\}" value="$\{L.dari\}" data-chg="lap" data-k="dari"></div><div class="field"><label for="lap-sampai" class="small">Sampai tanggal</label><input id="lap-sampai" class="inp" type="date" max="$\{TODAY\}" value="$\{L.sampai\}" data-chg="lap" data-k="sampai"></div>`:''\}\
