    reindex();\
    const wb = XLSX.utils.book_new();\
    const add = (name, rows) => XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows.length ? rows : [\{keterangan:'(kosong)'\}]), name);\
    add('Pelanggan', S.pelanggan.map(p=>(\{kode:p.kode, nama:p.nama, alamat:p.alamat, no_wa:p.wa, wilayah:p.wilayah, jenis_tarif:katNama(p), kode_tarif:p.kat, skala:p.skala||'', tarif:p.tarif, satuan:p.satuan, tarif_perlu_dicek:p.cek?'Ya':'', jenis_usaha:p.usaha||'', petugas_monitor:ptgFull(p.ptg), penarik_lapangan:p.penarik||'', status:p.aktif?'Aktif':'Nonaktif', terdaftar_sejak:p.sejak, sumber:p.src?p.src.lembar+(p.src.no?' no. '+p.src.no:''):'Aplikasi'\})));\
    add('Pembayaran', S.bayar.map(b=>(\{id:b.id, transaksi:b.grup, kode:b.pel, nama:(IX.pelMap.get(b.pel)||\{\}).nama||'', jenis:b.harian?'Harian ('+nPedagang(b)+' pedagang, '+(b.hari||0)+' hari)':b.rekap?'Setoran tanpa rincian':'Bulanan', bulan:b.periode, nominal:b.nominal, tanggal:b.tanggal, no_referensi:b.nomor, petugas_monitor:ptgNama(b.ptg), status:stBayar(b).t, sumber:b.sumber==='IMPORT'?'Mutasi rekening':b.sumber==='FILE'?'File setoran':'Dicatat petugas', dicatat_oleh:b.dibuatOleh, dicatat_pada:b.dibuatPada, diverifikasi_oleh:b.verifOleh, diverifikasi_pada:b.verifPada, cocok_mutasi:b.mutasiRef||'', keterangan:b.ket||'', alasan_batal:b.batal?b.batal.alasan:''\})));\
    const hr = []; S.bayar.forEach(b=>\{ if(b.harian && b.items) Object.entries(b.items).forEach(([k,h])=>hr.push(\{tanggal:b.tanggal, kode:k, nama:(IX.pelMap.get(k)||\{\}).nama||'', hari:h, nominal:h*((IX.pelMap.get(k)||\{\}).tarif||0), no_referensi:b.nomor, status:stBayar(b).t\})); \});\
    add('Rincian harian', hr);\
    add('Mutasi QRIS', S.mutasi.map(m=>(\{tanggal:m.tanggal, no_referensi:m.ref, nominal:m.nominal, status:isPaired(m)?'Dipasangkan':'Belum dipasangkan', file:m.file, diunggah_oleh:m.oleh, diunggah_pada:m.pada\})));\
    add('Wilayah', S.wilayah.map(w=>(\{nama:w.nama, jenis:w.jenis, petugas_monitor:ptgFull(w.ptg), hari_pasar_per_bulan:w.hariBuka||'', aktif:w.aktif!==false?'Ya':'Tidak'\})));\
    add('Audit trail', S.audit.map(a=>(\{waktu:a.waktu, pengguna:a.oleh, aksi:a.aksi, data:a.ket, sebelum_sesudah:diffText(a.sebelum,a.sesudah), alasan:a.alasan\})));\
    data = XLSX.write(wb, \{bookType:'xlsx', type:'array'\});\
  \}catch(e)\{ toast('File gagal dibuat. Periksa koneksi lalu coba lagi.', 'bad'); return; \}\
  if(await unduh('Resik_cadangan_'+TODAY+'.xlsx', data, XLSX_MIME, 'Cadangan data diunduh.')) commit([audit('Unduh cadangan data', 'backup', 'Cadangan seluruh data (Excel)', null, null, '')]);\
\}\
