  const btn = `<button class="paybtn qris" style="width:100%" data-act="gab-next" $\{sel.length?'':'disabled'\}>$\{ICON.qr\}BAYAR QRIS GABUNGAN<small>$\{sel.length?'Bayar '+rp(tot)+' sekali, lalu isi nomor referensinya':'Centang pedagang terlebih dahulu'\}</small></button>`;\
