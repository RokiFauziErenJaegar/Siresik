        didDrawPage: () => \{ doc.setFontSize(7.5); doc.setTextColor(110); doc.text('Resik Collect - dicetak '+nowStamp()+' oleh '+pdfSafe(userLabel())+' - hal. '+doc.internal.getNumberOfPages(), 14, doc.internal.pageSize.getHeight()-6); doc.setTextColor(0); \}\
