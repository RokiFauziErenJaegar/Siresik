/* ---------- REKONSILIASI ---------- */\
const ptgAktifRekon = () => S.petugas.filter(k=>k.aktif!==false && (wilOf(k.id).length || S.bayar.some(b=>b.ptg===k.id)));\
function vRekon()\{\
  const d = UI.rek.d, kf = UI.rek.ptg;\
  const all = rekonRange(d, d, '');\
  const kols = ptgAktifRekon().filter(k=>!kf || k.id===kf);\
  const es = kols.map(k=>all.find(e=>e.ptg===k.id) || \{ptg:k.id, empty:true\});\
  const act = es.filter(e=>!e.empty);\
  const D = sum(act,e=>e.dipungut), K = sum(act,e=>e.masuk), X = D-K;\
  const lepas = S.mutasi.filter(m=>!isPaired(m) && m.tanggal===d);\
  const monthFrom = d.slice(0,7)+'-01';\
  const cek = rekonRange(monthFrom, TODAY < monthEnd(d.slice(0,7)) ? TODAY : monthEnd(d.slice(0,7)), kf).filter(e=>e.status!=='OK' && e.tanggal!==d);\
  const showEmpty = UI.rek.kosong;\
  const nEmpty = es.filter(e=>e.empty).length;\
  return `\
  <div class="page-title"><div><h2>Rekonsiliasi QRIS</h2><p>QRIS yang dicatat petugas dibanding dana yang masuk ke rekening Bank Lampung</p></div></div>\
  <div class="formula-box">\
    <span class="ft">Formula rekonsiliasi DLH Pringsewu</span>\
    <code>TOTAL DIPUNGUT = QRIS YANG DICATAT</code>\
    <code>SELISIH = TOTAL DIPUNGUT \uc0\u8722  TOTAL MASUK REKENING</code>\
    <div class="fr"><i style="background:var(--em-500)"></i><span>Selisih 0 \uc0\u8594  <b>STATUS OK (HIJAU)</b></span></div>\
    <div class="fr"><i style="background:var(--orange-500)"></i><span>Tidak ada di mutasi / nominal beda \uc0\u8594  <b>STATUS PERIKSA (ORANGE)</b>, wajib diberi keterangan</span></div>\
    <div class="fr"><i style="background:var(--amber-400)"></i><span>Mutasi rekening belum diunggah \uc0\u8594  <b>MENUNGGU (KUNING)</b></span></div>\
  </div>\
  <div class="datebar">\
    <button class="icon-btn" data-act="rek-day" data-n="-1" aria-label="Hari sebelumnya">$\{ICON.left\}</button>\
    <input id="rek-d" class="inp" type="date" max="$\{TODAY\}" value="$\{d\}" data-chg="rekd" aria-label="Tanggal">\
    <button class="icon-btn" data-act="rek-day" data-n="1" aria-label="Hari berikutnya" $\{d>=TODAY?'disabled':''\}>$\{ICON.right\}</button>\
  </div>\
  <div class="chips scroll-x" role="group" aria-label="Pilih petugas">\
    <button class="fchip" data-act="rek-ptg" data-k="" aria-pressed="$\{!kf\}">Semua</button>\
    $\{ptgAktifRekon().map(k=>`<button class="fchip" data-act="rek-ptg" data-k="$\{k.id\}" aria-pressed="$\{kf===k.id\}">$\{esc(k.nama)\}</button>`).join('')\}\
  </div>\
  <div class="daysum">\
    <div><span class="lbl">Dipungut</span><b>$\{rp(D)\}</b></div>\
    <div><span class="lbl">Masuk rek.</span><b>$\{rp(K)\}</b></div>\
    <div><span class="lbl">Selisih</span><b style="color:$\{X?'var(--warn)':'var(--ok)'\}">$\{rp(X)\}</b></div>\
  </div>\
  <p class="muted small">$\{isCovered(d) ? 'Mutasi rekening tanggal ini sudah diunggah.' : '<b style="color:var(--wait)">Mutasi rekening tanggal ini belum diunggah bendahara.</b>'\}$\{act.some(e=>e.file)?' Setoran dari file bendahara dihitung sudah masuk.':''\}</p>\
  $\{lepas.length ? `<div class="note note-wait">Ada <b>$\{rp(sum(lepas,m=>m.nominal))\}</b> dana QRIS masuk rekening tanggal ini yang belum dipasangkan ke pelanggan ($\{lepas.length\} transaksi).$\{role()==='bendahara'?' Pasangkan di menu Bayar \uc0\u8594  Verifikasi.':''\}</div>` : ''\}\
  <div class="rek-grid">$\{es.filter(e=>!e.empty || showEmpty || kf).map(rekCard).join('') || '<div class="empty">Tidak ada pembayaran dicatat pada tanggal ini.</div>'\}</div>\
  $\{nEmpty && !kf ? `<button class="linkbtn" data-act="rek-kosong">$\{showEmpty?'Sembunyikan':'Tampilkan'\} $\{nEmpty\} petugas tanpa catatan</button>` : ''\}\
  $\{sec('alert', 'Hari lain yang perlu dicek', esc(blnLabel(d.slice(0,7)))+(kf?' \'b7 '+esc(ptgNama(kf)):''),\
    `<div class="alerts">$\{cek.slice(0,12).map(e=>`<button class="alert $\{e.status==='PERIKSA'?'a-warn':'a-wait'\}" data-act="goto-rekon" data-d="$\{e.tanggal\}" data-k="$\{kf\}"><i class="dot $\{e.status==='PERIKSA'?'warn':'wait'\}"></i><span><b>$\{tglS(e.tanggal)\} \'b7 $\{esc(ptgNama(e.ptg))\}</b> \'97 selisih $\{rp(e.selisih)\} \'b7 $\{e.status==='PERIKSA'?(e.note?'ada keterangan':'belum ada keterangan'):'mutasi belum diunggah'\}</span></button>`).join('') || '<div class="alert a-ok"><i class="dot ok"></i><span>Tidak ada hari lain yang perlu dicek.</span></div>'\}</div>`)\}`;\
\}\
function rekCard(e)\{\
  if(e.empty) return `<section class="card rek"><div class="rek-empty"><div><b>$\{esc(ptgNama(e.ptg))\}</b><div class="muted small">$\{tgl(UI.rek.d)\}</div></div><span class="muted small">Tidak ada pembayaran dicatat</span></div></section>`;\
  const cls = e.status==='OK'?'ok':e.status==='PERIKSA'?'warn':'wait';\
  const stTxt = e.status==='OK'?'STATUS: OK':e.status==='PERIKSA'?'STATUS: PERIKSA':'STATUS: MENUNGGU VERIFIKASI';\
  let body = '';\
  if(e.status==='TUNGGU') body += `<div class="note note-wait">$\{esc(e.alasan)\}</div>`;\
  if(e.status==='PERIKSA')\{\
    body += `<div class="note note-warn">$\{esc(e.alasan)\}</div>`;\
    body += `<div class="res" style="margin-top:0">$\{e.openR.slice(0,5).map(r=>refItem(r)).join('')\}</div>`;\
    if(can.note()) body += `<div class="field"><label for="nt-$\{e.key\}">Keterangan selisih <span style="color:var(--bad)">(wajib)</span></label><textarea id="nt-$\{e.key\}" class="inp" placeholder="Jelaskan penyebab selisih dan tindak lanjutnya.">$\{esc(e.note?e.note.teks:'')\}</textarea></div><button class="btn btn-sm" data-act="rek-note" data-key="$\{e.key\}">Simpan keterangan</button>`;\
    else body += e.note ? `<div class="note note-plain"><b>Keterangan:</b> $\{esc(e.note.teks)\}</div>` : `<div class="note note-bad"><b>Belum ada keterangan</b> dari bendahara.</div>`;\
    if(e.note) body += `<p class="muted small">Ditulis $\{esc(e.note.oleh)\}, $\{esc(e.note.pada)\}</p>`;\
  \} else if(e.note)\{ body += `<div class="note note-plain"><b>Keterangan:</b> $\{esc(e.note.teks)\}</div>`; \}\
  return `<section class="card rek s-$\{cls\}">\
    <div class="rek-head"><b>$\{esc(ptgNama(e.ptg))\}</b><span>$\{tgl(e.tanggal)\}</span></div>\
    <dl class="rek-dl">\
      <div><dt>$\{e.file && e.file===e.dipungut ? 'Setoran dari file' : 'QRIS dicatat'\} ($\{e.n\} transaksi)</dt><dd class="t-blue">$\{rp(e.dipungut)\}</dd></div>\
      <div class="sum"><dt>Total Dipungut</dt><dd>$\{rp(e.dipungut)\}</dd></div>\
      <div class="sum"><dt>Total Masuk Rekening</dt><dd class="t-em">$\{rp(e.masuk)\}</dd></div>\
      <div class="sel"><dt>Selisih</dt><dd style="color:$\{e.selisih===0?'var(--ok)':e.status==='PERIKSA'?'var(--warn)':'var(--wait)'\}">$\{rp(e.selisih)\}</dd></div>\
    </dl>\
    $\{body?`<div class="rek-body">$\{body\}</div>`:''\}\
    <div class="rek-status rs-$\{cls\}">$\{stTxt\}</div>\
  </section>`;\
\}\
