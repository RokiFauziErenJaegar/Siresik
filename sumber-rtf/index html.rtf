\}\
function ringkas(M, ptg)\{\
  const pels = S.pelanggan.filter(p=>!ptg || p.ptg===ptg);\
  const R = \{terdaftar:pels.length, aktif:0, lunas:0, menunggu:0, belum:0, potensi:0, belumRp:0, total:0, trx:0, lunasRp:0, pendRp:0, pendTrx:0,\
             selisih:0, periksaN:0, nunggak3:0, rekapN:0, rekapRp:0, hN:0, hHariIni:0, hTunggu:0, hHari:0, hRp:0, hPot:0, fileRp:0\};\
  const kini = M===CUR;\
  for(const p of pels)\{\
    if(!p.aktif) continue;\
    if(p.sejak && M < p.sejak) continue;\
    if(isHarian(p))\{\
      R.hN++; R.hPot += p.tarif * hariBuka(p.wilayah, M);\
      const e = IX.hIdx.get(p.kode);\
      if(e)\{ R.hHari += e.per[M]||0; if(kini)\{ const s = e.tgl.get(TODAY); if(s)\{ R.hHariIni++; if(s!=='LUNAS') R.hTunggu++; \} \} \}\
      continue;\
    \}\
