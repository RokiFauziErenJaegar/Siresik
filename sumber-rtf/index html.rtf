  return `\
  <div class="page-title"><div><h2>Halo, $\{esc(ptgNama(k))\}</h2><p>Petugas monitor $\{pasar?'pasar':'jalan protokol'\} \'b7 $\{esc(wilPtg(k)||'belum punya wilayah')\} \'b7 $\{hari(TODAY)\}, $\{tgl(TODAY)\}</p></div></div>\
