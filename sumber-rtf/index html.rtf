function todayList()\{\
  const k = myPtg();\
  const list = S.bayar.filter(b=>b.ptg===k && b.tanggal===TODAY).sort((a,b)=>(b.dibuatPada+b.id).localeCompare(a.dibuatPada+a.id));\
  const aktif = list.filter(b=>b.status!=='BATAL');\
  const byRef = groupByRef(aktif);\
  const items = [...byRef.entries()].map(([r,l])=>refItem(r,l)).join('') + list.filter(b=>b.status==='BATAL').map(b=>payItem(b)).join('');\
  return sec('history', 'Catatan hari ini', `$\{byRef.size\} transaksi \'b7 $\{rp(sum(aktif,b=>b.nominal))\}`, `<div class="res" style="margin-top:0">$\{items || '<div class="empty">Belum ada pembayaran yang dicatat hari ini.</div>'\}</div>`);\
\}\
function vVerif()\{\
