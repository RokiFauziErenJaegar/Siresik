\
/* Menu bawah */\
.tabbar\{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--surface);border-top:1px solid var(--line);box-shadow:0 -4px 16px rgba(15,23,42,.07);padding-bottom:env(safe-area-inset-bottom,0px)\}\
.tabs\{max-width:780px;margin:0 auto;display:grid;grid-template-columns:repeat(var(--n),1fr);padding-left:max(8px,env(safe-area-inset-left,0px));padding-right:max(8px,env(safe-area-inset-right,0px))\}\
