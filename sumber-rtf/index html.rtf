    const alasan = ($('#batal-alasan').value||'').trim();\
    if(alasan.length<5)\{ const e=$('#batal-err'); e.textContent='Tulis alasan pembatalan (minimal 5 huruf).'; e.hidden=false; $('#batal-alasan').focus(); return; \}\
    const ket = grupKet(b.grup); const before = stBayar(b).t; const t = nowStamp();\
    const recs = grupRecs(b.grup).filter(x=>x.status!=='BATAL');\
    const ops = [];\
    recs.forEach(x=>\{ x.batal = \{alasan, oleh:userLabel(), pada:t, statusSebelum:x.status\}; x.status='BATAL'; ops.push(opB(x)); \});\
    S.mutasi.forEach(m=>\{ if(m.grups && m.grups.includes(b.grup))\{ m.grups = m.grups.filter(g=>g!==b.grup); if(!m.grups.length) m.grups = null; if(role()==='bendahara') ops.push(\{t:'mutasi', row:m\}); \} \});\
    ops.push(audit('Batalkan pembayaran', b.grup, ket, \{status:before\}, \{status:'Batal'\}, alasan));\
    commit(ops, 'Batal');\
    closeSheet();\
    if(el.dataset.mode==='koreksi')\{\
      UI.tab='pembayaran'; if(role()==='bendahara') UI.bayar.seg='catat';\
      if(b.harian)\{\
        const pos = IX.pelMap.get(b.pel);\
        Object.assign(UI.bayar, freshBayar(), \{seg:UI.bayar.seg, mode:'gabung', gwil:pos?pos.wilayah:'', sel:Object.keys(b.items||\{\}), hsel:Object.assign(\{\}, b.items||\{\}), step:'pilih'\});\
        render(); scrollToCatat(); toast('Dibatalkan. Perbaiki daftar pedagang, lalu simpan ulang.');\
      \} else \{\
        Object.assign(UI.bayar, \{mode:'satu', pel:b.pel, months:recs.map(x=>x.periode), step:'form', hari:1, draft:\{nominal:sum(recs,x=>x.nominal), tanggal:b.tanggal, nomor:''\}, warn:''\});\
        render(); scrollToCatat(); toast('Dibatalkan. Silakan catat ulang dengan data yang benar.');\
