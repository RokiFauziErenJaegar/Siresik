.paybtns\{display:grid;grid-template-columns:1fr 1fr;gap:10px\}\
.paybtn\{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:98px;border-radius:14px;border:0;font-size:15.5px;font-weight:800;letter-spacing:.02em;color:var(--on-dark);box-shadow:0 2px 6px rgba(15,23,42,.15)\}\
