const stText = v => (ST[v]||\{t:v\}).t;\
function cellHtml(v,t)\{\
  if(v==null || v==='') return '<span class="muted">\'97</span>';\
  if(t==='rp') return rp(v); if(t==='int') return ribu(v); if(t==='pct') return v+'%'; if(t==='date') return tglS(v); if(t==='st') return chip(v);\
  return esc(v);\
\}\
function cellTxt(v,t)\{\
  if(v==null || v==='') return '';\
  if(t==='rp') return rp(v); if(t==='int') return ribu(v); if(t==='pct') return v+'%'; if(t==='date') return tgl(v); if(t==='st') return stText(v);\
  return String(v);\
\}\
function cellRaw(v,t)\{\
  if(v==null || v==='') return '';\
  if(t==='rp' || t==='int' || t==='pct') return Number(v); if(t==='date') return tgl(v); if(t==='st') return stText(v);\
  return String(v);\
\}\
function diffText(a,b)\{\
  if(!a && !b) return '';\
  const fmtV = (k,v) => v==null ? '\'97' : (['tarif','nominal','jumlah'].includes(k) && typeof v==='number') ? rp(v) : String(v);\
  const ks = [...new Set([...Object.keys(a||\{\}), ...Object.keys(b||\{\})])];\
  return ks.filter(k=>JSON.stringify((a||\{\})[k])!==JSON.stringify((b||\{\})[k])).map(k=>`$\{k\}: $\{a?fmtV(k,a[k]):'\'97'\} \uc0\u8594  $\{b?fmtV(k,b[k]):'\'97'\}`).join('; ');\
\}\
function auditItem(a)\{\
  const d = diffText(a.sebelum, a.sesudah);\
  return `<div class="audit-item"><b>$\{esc(a.aksi)\}</b><span class="meta">$\{esc(a.waktu)\} \'b7 $\{esc(a.oleh)\}</span><span>$\{esc(a.ket)\}</span>$\{d?`<span class="diff">$\{esc(d)\}</span>`:''\}$\{a.alasan?`<span>Alasan: $\{esc(a.alasan)\}</span>`:''\}</div>`;\
\}\
function buildReport()\{\
